            k_hdr = cmd_next(proj, conf, dry_run=False)
        pf.write_text("## Coverage\nCOVERED: a\nNOT COVERED: b\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_bare = cmd_next(proj, conf, dry_run=False)
        ok = (k_noreport == "stop-coverage-missing" and k_complete == "done"
              and k_incomplete == "stop-coverage-missing" and k_prose == "stop-coverage-missing"
              and k_hdr == "done" and k_bare == "done")
        print(f"{'PASS' if ok else 'FAIL'}: coverage-report gate blocks 'done' on a checked pass w/o report (F-0011)" + ("" if ok else f" -> {k_noreport},{k_complete},{k_incomplete},{k_prose},{k_hdr},{k_bare}"))
        failed += 0 if ok else 1
        pf.unlink()
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            cmd_metrics(proj)
        ok = "passes without coverage report: 1" in b.getvalue()
        print(f"{'PASS' if ok else 'FAIL'}: metrics reports passes without coverage report (F-0011)" + ("" if ok else f" -> {b.getvalue()[:120]}"))
        failed += 0 if ok else 1

    # F-0012: a rejected CF with an 'accepted' member is legal (§8 rule 4)
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(

            [f"F-{i:04d}" for i in range(1, 9)],
        ),
        (
            "reopened batch also capped at batch_size (F-0003)",
            rows(*((f"F-{i:04d}", "reopened", "Remediator") for i in range(1, 12))),
            [],
            True,
            "run-remediator",
            [f"F-{i:04d}" for i in range(1, 9)],
        ),

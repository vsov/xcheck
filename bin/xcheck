def selftest():
    def rows(*specs):
        return [
            {"id": i, "title": "t", "severity": "minor", "status": s, "next": n}
            for i, s, n in specs
        ]

    cases = [
        # (name, rows, unchecked, audit_exists, expected_kind, expected_detail)
        ("planner when no AUDIT.md", [], [], False, "run-planner", None),
        ("auditor on first unchecked pass", [], ["P-01", "P-02"], True, "run-auditor", "P-01"),
        ("triage blocks when only reported", rows(("F-0001", "reported", "human")), [], True, "stop-triage", ["F-0001"]),
        (

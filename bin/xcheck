        ok = rc == 0 and "clean" in b.getvalue()
        print(f"{'PASS' if ok else 'FAIL'}: lint accepts rejected-CF member reverted to accepted (F-0012)" + ("" if ok else f" -> rc={rc} {b.getvalue()[:120]}"))
        failed += 0 if ok else 1

    # F-0012 (Verifier reopen): the PENDING pre-sync state is also legal — CF
    # rejected, member file still `superseded-by-class`, LEDGER already `accepted`
    # (§2 rule 3 member-reversion delta). lint must not flag the ledger/file gap.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"

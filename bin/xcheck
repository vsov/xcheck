#!/usr/bin/env python3
"""xcheck orchestrator — drives the audit cycle between its human gates.

Usage:
  xcheck [--project DIR] [--dry-run] next          run ONE session (whoever's turn it is)
  xcheck [--project DIR] [--dry-run] loop [--step] [--max-sessions N]
                                                   run sessions until a human gate
  xcheck [--project DIR] [--budget SECONDS] loop   (loop also takes a wall-clock cap)
  xcheck [--project DIR] status                    read-only: state + decision preview
  xcheck [--project DIR] lint                      read-only: ledger<->finding-file consistency
  xcheck [--project DIR] metrics                   read-only: spec §11 metrics
  xcheck [--project DIR] unlock [--force]          remove a stale lock
  xcheck selftest                                  run the built-in decision-logic tests

The orchestrator is a courier, not a brain: all methodology lives in the
project's audit/XCHECK.md. This tool only reads audit/LEDGER.md and
audit/AUDIT.md, decides whose turn it is, launches the corresponding agent
CLI headlessly, and stops at every gate the methodology gives the human:
triage needed, ⚠ needs-human, empty queue (done), or a session error.

Config: audit/orchestrator.conf (KEY=VALUE), created with defaults on first
run. {prompt} in a *_cmd value is replaced with the role prompt; a command
without {prompt} gets the prompt appended as its final argument.

Lock: audit/.lock (JSON: pid, role, started, host). Created for every
writing session, removed on exit (including Ctrl-C). A live foreign lock
aborts the run; a dead one must be cleared with `xcheck unlock`.

Source of truth (XCHECK.md §2/§9.4): the finding file is the truth for
non-triage statuses; LEDGER.md is a derived index. The orchestrator
reconciles the two before deciding — a non-triage ledger<->file mismatch
takes the frontmatter status, while a pending-triage decision (file
'reported', ledger accepted/rejected/deferred) keeps the ledger value and
flows to the file on next contact (§2 rule 3). `lint` reports any drift.
"""

import json
import os
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------- defaults

DEFAULT_CONF = """\
# xcheck orchestrator config (KEY=VALUE, # comments). {prompt} = role prompt.
# session_note: appended to every role prompt (project-specific cautions).
session_note=
planner_cmd=codex exec --sandbox workspace-write {prompt}
auditor_cmd=codex exec --sandbox workspace-write {prompt}
verifier_cmd=codex exec --sandbox workspace-write {prompt}
remediator_cmd=claude -p --dangerously-skip-permissions {prompt}
batch_size=8
max_sessions=20
# triage_batch_cap: 0 = unbounded (audit until queue empties before triage);
# N = stop for triage once N findings pile up in 'reported' (smaller sittings).
triage_batch_cap=0
# push_after_commit: empty/off = never push (default); on/true/1/yes = git push after each courier commit.
push_after_commit=
"""

TRIAGE_STATUSES = {"accepted", "rejected", "deferred"}
TERMINAL = {"closed", "rejected", "withdrawn", "obsolete", "superseded-by-class"}

PROMPTS = {
    "Planner": (
        "Read audit/XCHECK.md. Role: Planner. Charter: inventory this project "
        "and its norms; produce audit/AUDIT.md. Do not audit anything yet."
    ),
    "Auditor": (
        "Read audit/XCHECK.md and audit/AUDIT.md. Role: Auditor. "
        "Charter: pass {charter}. Stop conditions per charter."
    ),
    "Remediator": (
        "Read audit/XCHECK.md and audit/AUDIT.md. Role: Remediator. "
        "Charter: {charter} (see LEDGER). Follow the XCHECK.md §3 sequence "
        "strictly; sync pending triage decisions on contact per §2 rule 3. "
        "If the project uses git, COMMIT your changes before finishing, with "
        "the finding ids in the message (XCHECK.md §9 rule 7) — stage only "
        "the files you yourself changed, never pre-existing dirt."
    ),
    "Verifier": (
        "Read audit/XCHECK.md and audit/AUDIT.md. Role: Verifier. "
        "Charter: {charter}. You did not write these fixes; try to prove them "
        "wrong. If your sandbox cannot commit, leave changes unstaged and say so."
    ),
}

# ---------------------------------------------------------------- parsing


LEDGER_ROW_RE = re.compile(
    r"^\|\s*((?:F|CF)-\d{4})\s*\|(.*?)\|\s*(\w+)\s*\|\s*([\w-]+)\s*\|(.*?)\|"
)
LEDGER_HEADER_RE = re.compile(r"^\|\s*id\s*\|\s*title\s*\|", re.I)
LEDGER_SEP_RE = re.compile(r"^\|[\s\-:|]+\|?\s*$")
LIMIT_KEYS = ("max_findings_per_pass", "remediation_batch_size", "class_threshold", "reopen_limit")


def parse_ledger(audit_dir: Path):
    """LEDGER.md table rows -> list of dicts (id, title, severity, status, next)."""
    rows = []
    ledger = audit_dir / "LEDGER.md"
    if not ledger.is_file():
        return rows
    for line in ledger.read_text(encoding="utf-8").splitlines():
        m = LEDGER_ROW_RE.match(line)
        if m:
            rows.append(
                {
                    "id": m.group(1),
                    "title": m.group(2).strip(),
                    "severity": m.group(3),
                    "status": m.group(4),
                    "next": m.group(5).strip(),
                }
            )
    return rows


def ledger_malformed_rows(audit_dir: Path):
    """Lines in LEDGER.md that should be table rows but do not parse (F-0004).

    LEDGER.md is a pure table (header + separator + one row per finding). Any
    non-blank line that is not the header, not a separator, and not a valid row
    is malformed — the fail-open parser would otherwise drop it silently, and a
    dropped active finding can produce a false 'done'. Returns the offending
    lines (empty list when the ledger is clean or absent)."""
    ledger = audit_dir / "LEDGER.md"
    if not ledger.is_file():
        return []
    bad = []
    for line in ledger.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        if LEDGER_HEADER_RE.match(line) or LEDGER_SEP_RE.match(line):
            continue
        if not LEDGER_ROW_RE.match(line):
            bad.append(line.strip())
    return bad


def parse_limits(audit_dir: Path):
    """Per-project limit overrides from AUDIT.md §5 (XCHECK.md §10 lets AUDIT.md
    override any default). Returns {key: int} for recognised keys only."""
    out = {}
    audit_md = audit_dir / "AUDIT.md"
    if not audit_md.is_file():
        return out
    for line in audit_md.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^\s*(?:[-*]\s*)?(\w+)\s*:\s*(\d+)\b", line)
        if m and m.group(1) in LIMIT_KEYS:
            out[m.group(1)] = int(m.group(2))
    return out


def effective_rows(audit_dir: Path):
    """Ledger rows reconciled with finding-file frontmatter (XCHECK.md §9.4:
    the finding file is truth for non-triage statuses). A pending-triage delta
    (file 'reported', ledger accepted/rejected/deferred) keeps the ledger
    status — it flows ledger->file per §2 rule 3. Any other mismatch adopts the
    frontmatter status. Returns (rows, findings-frontmatter)."""
    rows = parse_ledger(audit_dir)
    fnd = load_findings(audit_dir)
    seen = set()
    for r in rows:
        seen.add(r["id"])
        fm = fnd.get(r["id"])
        if not fm:
            continue
        fstatus = fm.get("status")
        if not fstatus or fstatus == r["status"]:
            continue
        pending_triage = fstatus == "reported" and r["status"] in TRIAGE_STATUSES
        if not pending_triage:
            r["status"] = fstatus
    # F-0005: a finding file present but ABSENT from the derived ledger is still
    # canonical state (§2: the finding file is the single source of truth; the
    # ledger is a derived index). Reconciling only existing ledger rows lets such
    # a finding vanish from the decision and yields a false 'done'. Synthesize a
    # row from its frontmatter so the decision sees the real state.
    for fid, fm in sorted(fnd.items()):
        if fid in seen:
            continue
        rows.append({
            "id": fid,
            "title": fm.get("title", ""),
            "severity": fm.get("severity", "minor"),
            "status": fm.get("status", ""),
            "next": "",
        })
    return rows, fnd


def parse_queue(audit_dir: Path):
    """AUDIT.md pass queue -> (unchecked pass ids, checked pass ids)."""
    unchecked, checked = [], []
    audit_md = audit_dir / "AUDIT.md"
    if not audit_md.is_file():
        return unchecked, checked
    for line in audit_md.read_text(encoding="utf-8").splitlines():
        m = re.match(r"^\s*-\s*\[( |x)\]\s*(P-\d{2})\b", line)
        if m:
            (checked if m.group(1) == "x" else unchecked).append(m.group(2))
    return unchecked, checked


def _coverage_marker(text, label):
    """True iff `label` (COVERED / NOT COVERED) appears as a coverage MARKER with
    NON-EMPTY content. A marker is the label at the START of a line, allowing
    markdown heading (`### `) or bold (`**`) decoration, closed by `:`, `**`, or
    the line end. A bare mid-sentence mention ("...merely mentions COVERED and
    NOT COVERED without reporting scope.") is NOT a marker (F-0011 adversarial
    bypass). Anchor at line start so the COVERED inside NOT COVERED never
    satisfies COVERED. F-0011 hardening: an EMPTY marker (`NOT COVERED:` with
    nothing after it on the line and no non-blank line before the next marker /
    heading / end) is a silent gap and does NOT qualify — §4 rule 5 demands the
    pass state what it did not cover, not merely print the label."""
    pat = re.compile(
        rf"^[ \t]*(?:#{{1,6}}[ \t]+|\*\*[ \t]*)?{label}\b[ \t]*(?::|\*\*|$)(?P<rest>.*)$",
        re.MULTILINE,
    )
    for m in pat.finditer(text):
        # content on the marker line itself?
        if m.group("rest").strip(" \t*:"):
            return True
        # else scan following lines until the next marker/heading/blank-run end
        tail = text[m.end():].splitlines()
        for line in tail:
            s = line.strip()
            if not s:
                continue
            # A markdown heading (`## ...`) is a NEW section boundary, not content
            # of this marker — so an empty marker followed by a heading is empty.
            if re.match(r"^#{1,6}\s", s):
                break
            # A following COVERED/NOT COVERED marker line is also a boundary, empty.
            if re.match(r"^(?:\*\*\s*)?(?:NOT\s+)?COVERED\b", s, re.I):
                break
            # Anything else non-blank (list item, prose, quote) is real content.
            return True
    return False


def passes_without_coverage(audit_dir: Path):
    """Checked passes (AUDIT.md `[x]`) that lack a complete coverage report
    (XCHECK.md §4 rule 5: a coverage report is mandatory; a silent gap is a
    protocol violation). A checked pass is documented only when a matching
    `passes/P-NN-*.md` exists AND its body carries both a COVERED and a
    NOT COVERED marker. Returns the offending pass ids (empty when every
    checked pass is documented). A single queue checkbox is NOT a substitute
    for the report (F-0011)."""
    _, checked = parse_queue(audit_dir)
    pdir = audit_dir / "passes"
    bad = []
    for pid in checked:
        files = sorted(pdir.glob(f"{pid}-*.md")) if pdir.is_dir() else []
        if not files:
            bad.append(pid)
            continue
        text = "\n".join(f.read_text(encoding="utf-8", errors="replace") for f in files)
        # A report is complete only when BOTH lists are present AS MARKERS —
        # `**COVERED:**` / `### COVERED` / `COVERED:` and the NOT COVERED forms.
        # A bare prose mention of the words does not qualify (§4 rule 5 demands
        # the pass state explicitly what it did not cover, not name the words).
        has_not_covered = _coverage_marker(text, "NOT COVERED")
        has_covered = _coverage_marker(text, "COVERED")
        if not (has_covered and has_not_covered):
            bad.append(pid)
    return bad


def load_conf(audit_dir: Path, write_default: bool = False):
    conf_path = audit_dir / "orchestrator.conf"
    if not conf_path.is_file():
        if write_default:
            conf_path.write_text(DEFAULT_CONF, encoding="utf-8")
        text = DEFAULT_CONF
    else:
        text = conf_path.read_text(encoding="utf-8")
    conf = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        conf[k.strip()] = v.strip()
    conf.setdefault("batch_size", "8")
    conf.setdefault("max_sessions", "20")
    conf.setdefault("session_note", "")
    conf.setdefault("triage_batch_cap", "0")
    conf.setdefault("push_after_commit", "")
    return conf


# ---------------------------------------------------------------- decision


def decide(rows, unchecked_passes, audit_md_exists, batch_size=8, triage_cap=0):
    """Return (kind, detail). kind: stop-* | run-* | done.

    Priority: needs-human > verify > remediate > triage > audit > plan > done.
    Closing started work precedes opening new work; triage blocks only when
    nothing else is runnable, so pass batches can accumulate before a triage
    sitting (the pilot's working rhythm) — unless triage_cap bounds the pile.
    """
    for r in rows:
        if "needs-human" in r["next"]:
            return "stop-needs-human", r["id"]

    fixed = [r["id"] for r in rows if r["status"] == "fixed"]
    if fixed:
        return "run-verifier", fixed

    reopened = [r["id"] for r in rows if r["status"] == "reopened"]
    accepted_cf = [r["id"] for r in rows if r["status"] == "accepted" and r["id"].startswith("CF-")]
    # Remediator-runnable work: accepted F-findings plus interrupted in-progress
    # states. 'validated' and 'planned' are legal durable states owned by the
    # Remediator (§5), not ledger corruption — a session interrupted after
    # confirming/planning must be resumed, not flagged stop-inconsistent (F-0001).
    remediable = [
        r["id"] for r in rows
        if r["status"] in ("validated", "planned")
        or (r["status"] == "accepted" and r["id"].startswith("F-"))
    ]
    if reopened:
        # F-0003: the remediation_batch_size cap (§10) bounds EVERY Remediator
        # batch, not only the 'remediable' collection — reopened work is a
        # Remediator session too and must respect the same session boundary.
        return "run-remediator", reopened[:batch_size]
    if accepted_cf:
        return "run-remediator", [accepted_cf[0]]
    if remediable:
        return "run-remediator", remediable[:batch_size]

    reported = [r["id"] for r in rows if r["status"] == "reported"]
    # triage_cap (0 = unbounded): when the reported pile reaches the cap,
    # stop for a triage sitting BEFORE opening more audit passes, so the
    # human triages in digestible batches instead of one huge sitting.
    if triage_cap and len(reported) >= triage_cap:
        return "stop-triage", reported

    if unchecked_passes:
        return "run-auditor", unchecked_passes[0]

    if reported:
        return "stop-triage", reported

    if not audit_md_exists:
        return "run-planner", None

    disputed = [r["id"] for r in rows if r["status"] == "disputed"]
    if disputed:
        return "stop-disputed", disputed
    deferred = [r["id"] for r in rows if r["status"] == "deferred"]
    non_terminal = [r["id"] for r in rows if r["status"] not in TERMINAL and r["status"] not in ("deferred", "disputed")]
    if non_terminal:
        return "stop-inconsistent", non_terminal
    if deferred:
        return "done-deferred-debt", deferred
    return "done", None


def role_and_charter(kind, detail):
    if kind == "run-planner":
        return "Planner", None
    if kind == "run-auditor":
        return "Auditor", detail
    if kind == "run-remediator":
        ids = detail
        if len(ids) == 1:
            return "Remediator", f"finding {ids[0]}"
        return "Remediator", f"findings {ids[0]}..{ids[-1]} ({len(ids)} items: {', '.join(ids)})"
    if kind == "run-verifier":
        ids = detail
        return "Verifier", f"every finding in status fixed ({', '.join(ids)})"
    raise ValueError(kind)


# ---------------------------------------------------------------- lock


class Lock:
    def __init__(self, audit_dir: Path, role: str):
        self.path = audit_dir / ".lock"
        self.role = role

    def acquire(self):
        payload = json.dumps(
            {
                "pid": os.getpid(),
                "role": self.role,
                "started": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                "host": socket.gethostname(),
            }
        )
        try:
            fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            info = self.read()
            alive = info and pid_alive(info.get("pid", -1))
            state = "LIVE" if alive else "STALE (pid dead)"
            raise SystemExit(
                f"audit/.lock exists — {state}: {info}. "
                f"{'Another writing session is active; wait for it.' if alive else 'Run `xcheck unlock` to clear it.'}"
            )
        with os.fdopen(fd, "w") as f:
            f.write(payload)

    def relabel(self, role: str):
        """Rewrite the held lock's role label (pid/started/host preserved).
        Used when cmd_next acquires the lock before the role is decided."""
        info = self.read() or {}
        info["role"] = role
        try:
            self.path.write_text(json.dumps(info), encoding="utf-8")
        except OSError:
            pass
        self.role = role

    def read(self):
        try:
            return json.loads(self.path.read_text(encoding="utf-8"))
        except Exception:
            return None

    def release(self):
        try:
            self.path.unlink()
        except FileNotFoundError:
            pass


def pid_alive(pid):
    # F-0010: os.kill(pid, 0) distinguishes three cases, and only ONE means
    # dead. ProcessLookupError (ESRCH) => no such process. PermissionError
    # (EPERM) => the process EXISTS but we may not signal it (foreign owner on a
    # shared checkout) — that is alive, not stale; treating it as dead lets
    # `unlock` clear a live foreign lock without --force (§4 rule 8). A bad
    # pid value (ValueError/TypeError) is not provably alive, so: not alive.
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (OSError, ValueError, TypeError):
        return False
    return True


# ---------------------------------------------------------------- sessions


def build_cmd(conf, role, prompt):
    tmpl = conf.get(f"{role.lower()}_cmd")
    if not tmpl:
        raise SystemExit(f"orchestrator.conf lacks {role.lower()}_cmd")
    parts = shlex.split(tmpl)
    if "{prompt}" in parts:
        return [prompt if p == "{prompt}" else p for p in parts]
    return parts + [prompt]


def run_session(project: Path, conf, role, charter, dry_run=False, lock=None):
    """Run one agent session. If `lock` is given, the caller already holds the
    writing lock and this call runs (subprocess + courier) inside it — the whole
    next-transaction is serialized (F-0009). If `lock` is None (standalone call),
    the session acquires and releases its own lock, with the courier commit still
    inside the locked region: acquire -> subprocess -> courier -> release."""
    prompt = PROMPTS[role].format(charter=charter) if charter else PROMPTS[role]
    note = conf.get("session_note", "").strip()
    if note:
        prompt += f" Project note from the operator: {note}"
    cmd = build_cmd(conf, role, prompt)
    print(f"\n=== {role} session ===")
    print(f"charter: {charter or '(role default)'}")
    print(f"command: {' '.join(shlex.quote(c) for c in cmd[:4])} ... [+prompt]")
    if dry_run:
        print("dry-run: not executing.")
        return 0

    own_lock = lock is None
    if own_lock:
        lock = Lock(project / "audit", role)
        lock.acquire()
    try:
        # F-0009: EVERY orchestrator write — including creating the log dir —
        # must happen inside the critical section. In the standalone branch this
        # dir was created before acquire(), so a write escaped the lock. Do it
        # after acquire so the whole session (log dir, subprocess, courier) is
        # serialized under one lock: acquire -> writes -> courier -> release.
        logs = project / "audit" / "orchestrator-logs"
        logs.mkdir(exist_ok=True)
        ts = datetime.now().strftime("%Y%m%d-%H%M%S")
        log_path = logs / f"{ts}-{role.lower()}.log"
        pre_dirty = dirty_paths(project)
        t0 = time.time()
        with open(log_path, "w", encoding="utf-8") as log:
            proc = subprocess.run(cmd, cwd=project, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
        rc = proc.returncode
        mins = (time.time() - t0) / 60
        print(f"exit={rc} after {mins:.1f} min; log: {log_path.relative_to(project)}")
        tail = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-8:]
        for line in tail:
            print(f"  | {line}")
        committed = courier_commit(project, role, charter, pre_dirty, conf)
    finally:
        if own_lock:
            lock.release()
    if not committed:
        # courier could not durably commit; do not let next/loop advance to a
        # role (e.g. Verifier) that needs the diff (F-0008).
        return rc if rc != 0 else 1
    return rc


def dirty_paths(project: Path):
    """Set of dirty/untracked paths from git status (None if not a repo)."""
    r = subprocess.run(
        ["git", "status", "--porcelain"], cwd=project, capture_output=True, text=True
    )
    if r.returncode != 0:
        return None
    return {l[3:].split(" -> ")[-1] for l in r.stdout.splitlines() if l.strip()}


def session_dirt(pre, post):
    """Paths a session left behind: new dirt only — pre-existing dirt is
    someone else's work (pilot lesson: operator's bench/ must never be
    swept into a courier commit)."""
    if pre is None or post is None:
        return set()
    return post - pre


def courier_commit(project: Path, role: str, charter, pre, conf=None):
    """Pilot lessons: codex sandbox can't commit; full-auto sessions
    under-commit. Finish the session's own commit — new dirt only.

    Returns True when there was nothing to commit or the commit succeeded;
    False when `git add`/`git commit` failed — so the caller can stop instead
    of claiming a durable handoff that did not happen (F-0008)."""
    post = dirty_paths(project)
    new = sorted(session_dirt(pre, post))
    if not new:
        return True
    add = subprocess.run(["git", "add", "--"] + new, cwd=project, check=False)
    if add.returncode != 0:
        print(f"courier: git add FAILED (rc={add.returncode}) — state NOT committed for {role}")
        return False
    what = charter or "session artifacts"
    scope = "audit" if all(p.startswith("audit/") for p in new) else "audit+material"
    commit = subprocess.run(
        ["git", "commit", "-q", "-m",
         f"{'docs' if scope == 'audit' else 'fix'}(audit): {role.lower()} — {what} (orchestrated courier commit)"],
        cwd=project,
        capture_output=True,
        text=True,
        check=False,
    )
    if commit.returncode != 0:
        detail = (commit.stderr or commit.stdout or "").strip()[:120]
        print(f"courier: git commit FAILED (rc={commit.returncode}) — state NOT committed for {role}: {detail}")
        return False
    print(f"courier: committed the session's new dirt ({len(new)} paths, {scope}) for {role}")
    leftover = (post - set(new)) if post else set()
    if leftover:
        print(f"note: {len(leftover)} dirty paths predated the session — left untouched")
    # B5: opt-in auto-push (default off — never push without explicit opt-in).
    if conf and conf.get("push_after_commit", "").strip().lower() in ("1", "true", "yes", "on"):
        r = subprocess.run(["git", "push"], cwd=project, capture_output=True, text=True)
        print("courier: git push " + ("ok" if r.returncode == 0 else f"FAILED — {r.stderr.strip()[:120]}"))
    return True


# ---------------------------------------------------------------- commands


def state_and_decision(project: Path, conf):
    audit = project / "audit"
    # F-0004: a syntactically broken ledger row would be dropped fail-open and
    # could yield a false 'done'; refuse to decide on a corrupt durable state.
    malformed = ledger_malformed_rows(audit)
    rows, fnd = effective_rows(audit)  # F-0005: reconcile with finding-file truth
    unchecked, checked = parse_queue(audit)
    if malformed:
        return rows, unchecked, checked, "stop-ledger-corrupt", malformed
    limits = parse_limits(audit)
    # F-0005: enforce the reopen limit from the finding file's own attempts even
    # when the ledger flag is not yet set. A finding currently 'reopened' has
    # been reopened attempts+1 times; at reopen_limit it needs a human.
    reopen_limit = int(limits.get("reopen_limit", 2))
    for r in rows:
        if r["status"] == "reopened" and "needs-human" not in r["next"]:
            attempts = int((fnd.get(r["id"], {}) or {}).get("attempts", "0") or 0)
            if attempts + 1 >= reopen_limit:
                return rows, unchecked, checked, "stop-needs-human", r["id"]
    # F-0003: AUDIT.md remediation_batch_size (§10 override) wins over the conf
    # default when present.
    batch = int(limits.get("remediation_batch_size", conf.get("batch_size", "8")))
    kind, detail = decide(
        rows, unchecked, (audit / "AUDIT.md").is_file(),
        batch, int(conf.get("triage_batch_cap", "0") or 0),
    )
    # F-0011: the queue emptying is not enough to declare the audit finished —
    # every checked pass must carry its mandatory coverage report (§4 rule 5).
    # A checkbox without a passes/P-NN-*.md report is exactly the silent gap the
    # methodology forbids; refuse to advance to 'done' while one exists.
    if kind.startswith("done"):
        missing = passes_without_coverage(audit)
        if missing:
            return rows, unchecked, checked, "stop-coverage-missing", missing
    return rows, unchecked, checked, kind, detail


def cmd_status(project: Path, conf):
    audit = project / "audit"
    if not (audit / "XCHECK.md").is_file():
        raise SystemExit(f"{audit}/XCHECK.md not found — install xcheck first (bootstrap.md)")
    rows, unchecked, checked, kind, detail = state_and_decision(project, conf)
    counts = {}
    for r in rows:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print(f"project: {project}")
    print(f"passes: {len(checked)} done, {len(unchecked)} queued {unchecked or ''}")
    print(f"findings: {len(rows)} total — " + ", ".join(f"{k}:{v}" for k, v in sorted(counts.items())) or "none")
    lock = Lock(audit, "?").read()
    if lock:
        print(f"lock: {lock} ({'LIVE' if pid_alive(lock.get('pid', -1)) else 'STALE'})")
    print(f"decision: {kind}" + (f" -> {detail}" if detail else ""))


def cmd_next(project: Path, conf, dry_run):
    # F-0009: hold the writing lock across the WHOLE next-transaction — persist
    # the default orchestrator.conf, read state, decide, run the session, and
    # courier-commit — so a concurrent `next` cannot read the same queue and
    # launch a duplicate/stale session, and an abort on a live foreign lock
    # writes nothing (the conf write used to escape the lock, in main()).
    lock = None
    if not dry_run:
        lock = Lock(project / "audit", "orchestrator")
        lock.acquire()
    role = None
    try:
        if lock:
            # Under the lock: this is the only in-transaction default-conf write.
            # Moved out of main(), where it preceded acquire and let an aborting
            # `next` still create the file (§4 one-writer serialization).
            load_conf(project / "audit", write_default=True)
            # F-0009 hardening: re-read conf from disk UNDER the lock so the
            # decision and the launched session act on the current file, not the
            # pre-lock snapshot main() loaded (§4 rule 2, state from files). The
            # lock is per-writing-session by design; a concurrent orchestrator
            # mutating conf is already excluded by that lock — this only closes
            # the same-process stale-snapshot window.
            conf = load_conf(project / "audit")
        rows, unchecked, checked, kind, detail = state_and_decision(project, conf)
        if kind.startswith("stop-") or kind.startswith("done"):
            report_gate(kind, detail)
            return kind
        role, charter = role_and_charter(kind, detail)
        if lock:
            lock.relabel(role)
        rc = run_session(project, conf, role, charter, dry_run, lock=lock)
    finally:
        if lock:
            lock.release()
    if rc != 0:
        print(f"stop: {role} session returned exit {rc} — investigate before continuing")
        return "stop-error"
    return kind


def cmd_loop(project: Path, conf, dry_run, step, max_sessions, budget=None, clock=None):
    clock = clock or time.time
    start = clock()
    for i in range(max_sessions):
        if budget is not None and clock() - start >= budget:
            print(f"stop: --budget {budget}s reached (spent {int(clock() - start)}s)")
            return
        kind = cmd_next(project, conf, dry_run)
        if kind.startswith("stop-") or kind.startswith("done") or dry_run:
            return
        if step:
            input("— session finished; Enter = next, Ctrl-C = stop —")
    print(f"stop: max_sessions={max_sessions} reached (cost cap)")


def report_gate(kind, detail):
    if kind == "stop-triage":
        print(f"gate: triage needed — {len(detail)} findings in reported. Dialogue: /xcheck-triage; or edit LEDGER.md")
    elif kind == "stop-needs-human":
        print(f"gate: ⚠ needs-human on {detail} — the human decides (see the finding file)")
    elif kind == "stop-inconsistent":
        print(f"stop: non-terminal statuses with no move {detail} — ledger out of sync? xcheck status")
    elif kind == "stop-ledger-corrupt":
        print(f"stop: LEDGER.md contains {len(detail)} row(s) unparsable as finding rows — repair the ledger, else an active finding is silently lost:")
        for ln in detail:
            print(f"  ✗ {ln}")
    elif kind == "stop-coverage-missing":
        print(f"stop: {len(detail)} checked pass(es) without a full coverage report (§4 rule 5) — a silent gap; the audit cannot count as complete:")
        for pid in detail:
            print(f"  ✗ {pid}: no passes/{pid}-*.md with COVERED / NOT COVERED sections")
    elif kind == "stop-disputed":
        # §5: disputed resolves only to accepted (Auditor/human side with the
        # finding) or withdrawn (side against it).
        print(f"gate: dispute — {detail} in disputed. Auditor or human decides (§5, §9.3): accepted (side with the finding) | withdrawn (against it)")
    elif kind == "done-deferred-debt":
        # §5 has no transition out of deferred: it is terminal debt. Reviving it
        # is a human decision outside the automatic cycle, not a machine move.
        print(f"audit complete with deferred debt: {detail} in deferred (terminal per §5 — the state machine has no transition out of deferred; returning it to work is a human decision outside the automatic cycle)")
    elif kind == "done":
        print("audit complete: queue empty, all rows terminal")
    else:
        print(kind)


def cmd_unlock(project: Path, force):
    lock = Lock(project / "audit", "?")
    info = lock.read()
    if info is None and not lock.path.exists():
        print("no lock present")
        return
    if info and pid_alive(info.get("pid", -1)) and not force:
        raise SystemExit(f"lock is LIVE ({info}) — remove only with --force if you are sure")
    lock.release()
    print(f"lock removed ({info})")



            (audit / "findings" / "F-0002-a.md").write_text(
                "---\nid: F-0002\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: closed\nrecurrence-of: F-0001\nattempts: 0\n---\n", encoding="utf-8")
        return _setup
    rc_self, o_self = _lint_out(_rec_self())
    rc_cycle, o_cycle = _lint_out(_rec_cycle())
    ok = (rc_term == 0 and "clean" in o_term
          and rc_live == 1 and "not terminal" in o_live

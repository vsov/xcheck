#!/usr/bin/env python3
"""xcheck orchestrator — entry point.

Everything lives in the `xcheck` package beside this script; see
`xcheck/__init__.py` for the module layering and `xcheck/cli.py` for the
argument grammar and the `--help` text.

The sys.path line exists because this script is normally invoked by absolute
path (`/path/to/xcheck/bin/xcheck --project ...`), not through an installed
console script, so the repo root is not otherwise importable. Phase 10 adds
proper packaging; until then this is the whole of the bootstrap.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from xcheck.cli import main  # noqa: E402  (must follow the sys.path bootstrap)

if __name__ == "__main__":
    sys.exit(main(sys.argv))

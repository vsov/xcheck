    # CF-0001 re-take (meta-check, human ruling point 3 + adversarial self-check point 4):
    # the schema table is DERIVED from §2, proven by a bijection the selftest exercises in
    # both directions plus its two failure modes. This is the mechanism that makes a new §2
    # field impossible to add without a validator — the technique that closed F-0077.
    # (a) The shipped methodology §2 (the real XCHECK.md beside bin/xcheck, when present)
    #     declares EXACTLY the schema's in-block fields — prose bound to code, no hand copy.
    shipped = Path(__file__).resolve().parent.parent / "XCHECK.md"
    if shipped.is_file():
        live = section2_canonical_fields(shipped.read_text(encoding="utf-8", errors="replace"))
        ok_a = live is not None and set(live) == set(SCHEMA_BLOCK_FIELDS) and not _schema_meta_diff(live)
        detail_a = f"§2={sorted(live) if live else None} schema={sorted(SCHEMA_BLOCK_FIELDS)}"
    else:
        # No shipped XCHECK.md beside an installed bin — the runtime bind still holds:
        # cmd_lint runs the same meta-check against each project's audit/XCHECK.md.
        ok_a, detail_a = True, "no shipped XCHECK.md beside bin (runtime cmd_lint binds per project)"
    # (b) Adding a field to §2 that the table does not validate must be flagged.
    ok_b = any("entry in the code schema table" in it
               for it in _schema_meta_diff(sorted(SCHEMA_BLOCK_FIELDS) + ["bogus-field"]))
    # (c) Removing a table entry while §2 still declares it must be flagged (same failure
    #     surface: §2 now carries a field the schema no longer validates).
    _dropped = sorted(SCHEMA_BLOCK_FIELDS)[1:]  # schema missing the first in-block field
    ok_c = any("entry in the code schema table" in it
               for it in _schema_meta_diff(sorted(SCHEMA_BLOCK_FIELDS), schema_fields=_dropped))
    # (d) Dropping a field from §2 while the table still validates it must be flagged.
    ok_e = any("no longer declares it" in it
               for it in _schema_meta_diff(sorted(SCHEMA_BLOCK_FIELDS)[1:]))
    # (f) An exact mirror produces no issue (control).
    ok_d = not _schema_meta_diff(sorted(SCHEMA_BLOCK_FIELDS))
    ok = ok_a and ok_b and ok_c and ok_e and ok_d
    print(f"{'PASS' if ok else 'FAIL'}: CF-0001 meta-check — schema table is a bijection with XCHECK.md §2 (add-field, drop-entry, drop-§2-field all caught)"
          + ("" if ok else f" -> a={ok_a}({detail_a}) b={ok_b} c={ok_c} e={ok_e} d={ok_d}"))
    failed += 0 if ok else 1

    # CF-0001 I-10 reopen (meta-check, value coverage): name bijection alone let `blocked`
    # sit in the table with a None predicate on a delegation that was NOT fail-closed. The
    # value-coverage check binds the REQUIREMENT of a guard to §2: a field whose §2 value is
    # not a `<free-form>` placeholder must be predicated OR a declared fail-closed delegation.
    if shipped.is_file():
        vals = section2_canonical_field_values(shipped.read_text(encoding="utf-8", errors="replace")) or {}
        # (a) control: the shipped §2 + live schema is fully covered (blocked now predicated).
        ok_va = not _schema_value_coverage_issues(vals)
        # (b) dropping `blocked`'s value predicate (the exact I-10 hole) must be flagged as
        #     the class root — this is what name-bijection could not catch.
        _no_blocked = dict(CANONICAL_SCHEMA); _no_blocked["blocked"] = (True, False, None)
        ok_vb = any("'blocked'" in it and "class root" in it
                    for it in _schema_value_coverage_issues(vals, schema=_no_blocked))
        # (c) a field that is BOTH predicated and delegated (two validation sources) must be
        #     flagged — a delegation entry may not shadow a real predicate.
        _both = dict(DELEGATED_VALUE_GATES); _both["severity"] = "bogus"
        ok_vc = any("'severity'" in it and "BOTH" in it
                    for it in _schema_value_coverage_issues(vals, delegated=_both))
        detail_v = f"a={ok_va} b={ok_vb} c={ok_vc}"
    else:
        ok_va = ok_vb = ok_vc = True
        detail_v = "no shipped XCHECK.md beside bin (runtime cmd_lint binds per project)"
    # (d) DELEGATED_VALUE_GATES is a PIN: each entry escapes the predicate requirement only
    #     because a consumed-state poison proves its gate fail-closed ELSEWHERE — class via
    #     _broken_superseded/sole_cf (F-0050), recurrence-of via the lint ancestor check
    #     (F-0043), norm-ruling via the §8 norm-ratification gate (F-0042). Any change to
    #     this set trips here so a new delegation cannot be added without its own proof (the
    #     mistake that made `blocked` a silent no-op).
    ok_vd = set(DELEGATED_VALUE_GATES) == {"class", "recurrence-of", "norm-ruling"}
    ok = ok_va and ok_vb and ok_vc and ok_vd
    print(f"{'PASS' if ok else 'FAIL'}: CF-0001 I-10 — meta-check requires a value guard per constrained §2 field; delegated set is pinned to its proven gates"
          + ("" if ok else f" -> {detail_v} pinned={ok_vd} deleg={sorted(DELEGATED_VALUE_GATES)}"))
    failed += 0 if ok else 1

    # CF-0001 human rulings #4/#5 (meta-check, nullability): no canonical field may be BOTH
    # required and nullable. Nullability is DERIVED from §2 (`section2_field_nullable_map`:
    # a field is nullable IFF its §2-shown VALUE offers a `null` option — ruling #5: NOT from
    # a "list" comment), and `canonical_schema_nullability_issues`
    # REFUSES any schema entry whose nullable flag disagrees — so 'required and nullable'
    # (an empty value skipping the shared gate) cannot be declared field by field. Exercised
    # against the shipped §2 plus the point-4 mutation (flip a required field to nullable ->
    # must fail HERE, not only its poison) and its reverse.
    if shipped.is_file():
        nmap = section2_field_nullable_map(shipped.read_text(encoding="utf-8", errors="replace")) or {}
        # (a) the §2-derived nullable set is EXACTLY the fields whose §2 VALUE offers `null`
        #     (class/recurrence-of/blocked/norm-ruling) — a tripwire if §2 changes what may be
        #     absent. `unit` is NOT here (ruling #5: its shown value `<unit path>` is
        #     substantive, so it is required and non-nullable despite the "YAML list" comment).
        derived_nullable = {f for f, n in nmap.items() if n}
        ok_na = derived_nullable == {"class", "recurrence-of", "blocked", "norm-ruling"}
        # (b) control: the live schema agrees with §2 — no required-and-nullable contradiction.
        ok_nb = not canonical_schema_nullability_issues(nmap)
        # (c) point 4: flipping a §2-required field (title) to nullable must fail HERE.
        _null_title = dict(CANONICAL_SCHEMA); _null_title["title"] = (True, True, None)
        ok_nc = any("'title'" in it and "required and nullable" in it
                    for it in canonical_schema_nullability_issues(nmap, schema=_null_title))
        # (d) the reverse — marking a §2-nullable field (class) non-nullable — is caught too.
        _req_class = dict(CANONICAL_SCHEMA); _req_class["class"] = (True, False, None)
        ok_nd = any("'class'" in it and "nullable per XCHECK.md §2" in it
                    for it in canonical_schema_nullability_issues(nmap, schema=_req_class))
        detail_n = f"a={ok_na}({sorted(derived_nullable)}) b={ok_nb} c={ok_nc} d={ok_nd}"
    else:
        ok_na = ok_nb = ok_nc = ok_nd = True
        detail_n = "no shipped XCHECK.md beside bin (runtime cmd_lint binds per project)"
    ok = ok_na and ok_nb and ok_nc and ok_nd
    print(f"{'PASS' if ok else 'FAIL'}: CF-0001 human ruling #4 — schema nullability is bound to §2; no field is required-and-nullable (flip caught by the meta-check)"
          + ("" if ok else f" -> {detail_n}"))
    failed += 0 if ok else 1

    # F-0102 reopen (Verifier): `superseded-by-class` terminality is CONDITIONAL and
    # must be COMPUTED, not skipped. A member bidirectionally linked to a CLOSED CF
    # is terminal — its `next` must be `—`/`-`, so a foreign role (`Verifier`) is
    # caught; the same member with `—` is clean.
    def _superseded_next(nxt):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(_ledger(
                f"| F-0001 | a | major | superseded-by-class | {nxt} | 2026-07-21 |\n"
                "| CF-0001 | c | major | closed | — | 2026-07-21 |\n"), encoding="utf-8")
            (audit / "findings" / "F-0001-a.md").write_text(
                "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: superseded-by-class\nclass: CF-0001\nattempts: 0\n---\n", encoding="utf-8")
            (audit / "findings" / "CF-0001-c.md").write_text(
                "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: c\nseverity: major\ndimension: invariants\nunit: B01\nstatus: closed\nmembers: [F-0001]\nattempts: 0\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            return rc, b.getvalue()
    rc_bad, o_bad = _superseded_next("Verifier")
    rc_ok, o_ok = _superseded_next("—")
    ok = (rc_bad == 1 and "not the actor owning status 'superseded-by-class'" in o_bad
          and rc_ok == 0 and "clean" in o_ok)
    print(f"{'PASS' if ok else 'FAIL'}: closed-CF member's next owner is computed, foreign role caught (F-0102)" + ("" if ok else f" -> bad={rc_bad}/{o_bad[:100]} ok={rc_ok}/{o_ok[:80]}"))
    failed += 0 if ok else 1

    # F-0099: effective_rows honours the SECOND §2-rule-3 pending delta (rejected-CF
    # member reversion), not only reported→triage — so the reverted member keeps its
    # ledger `accepted` instead of being overridden back to `superseded-by-class`.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"
            "| CF-0001 | c | major | rejected | — | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: superseded-by-class\nclass: CF-0001\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "findings" / "CF-0001-c.md").write_text(
            "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: rejected\nmembers: [F-0001]\nattempts: 0\n---\n", encoding="utf-8")
        erows, _efnd = effective_rows(audit)
        member = next(r for r in erows if r["id"] == "F-0001")
        # control: a LIVE (non-rejected) CF is NOT a reversion — the member adopts
        # the file's superseded-by-class, not the ledger accepted.
        (audit / "findings" / "CF-0001-c.md").write_text(
            "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nmembers: [F-0001]\nattempts: 0\n---\n", encoding="utf-8")
        erows2, _ = effective_rows(audit)
        member2 = next(r for r in erows2 if r["id"] == "F-0001")
        ok = member["status"] == "accepted" and member2["status"] == "superseded-by-class"
        print(f"{'PASS' if ok else 'FAIL'}: effective_rows keeps rejected-CF member reversion, not live-CF (F-0099)" + ("" if ok else f" -> {member['status']}, {member2['status']}"))
        failed += 0 if ok else 1

    # F-0101: title and severity are canonical in the finding file — lint SURFACES a
    # ledger that disagrees, and metrics publish the frontmatter severity, not the
    # stale derived one.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | Ledger title | info | reported | Triage | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: Canonical title\nseverity: critical\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            rc = cmd_lint(Path(td))
        lint_out = b.getvalue()
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            cmd_metrics(Path(td))
        met_out = b.getvalue()
        ok = (rc == 1 and "ledger title" in lint_out and "ledger severity" in lint_out
              and "critical:1" in met_out and "info:1" not in met_out)
        print(f"{'PASS' if ok else 'FAIL'}: lint flags title/severity drift; metrics use frontmatter severity (F-0101)" + ("" if ok else f" -> rc={rc} {lint_out[:100]} | {met_out[met_out.find('severity'):][:40]}"))
        failed += 0 if ok else 1

    # F-0101 reopen (Verifier): an EMPTY/missing canonical title/severity is a
    # corrupted record, not "no drift" — the derived ledger value must NOT stand in
    # for it. lint must flag BOTH required fields (rc=1), and metrics must fail
    # CLOSED with an addressed diagnostic instead of publishing the ledger severity.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | Ledger title | info | reported | Triage | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle:\nseverity:\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            rc = cmd_lint(Path(td))
        lint_out = b.getvalue()
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            mrc = cmd_metrics(Path(td))
        met_out = b.getvalue()
        ok = (rc == 1 and "no canonical `title`" in lint_out and "no canonical `severity`" in lint_out
              and mrc == 1 and "metrics unavailable" in met_out and "info:1" not in met_out)
        print(f"{'PASS' if ok else 'FAIL'}: empty canonical title/severity -> lint rc=1 + metrics fail-closed (F-0101)" + ("" if ok else f" -> rc={rc} mrc={mrc} {lint_out[:120]} | {met_out[:80]}"))
        failed += 0 if ok else 1

    # F-0103: a duplicated singleton frontmatter key is caught by lint AND fails the
    # decision path closed (no role routed off an arbitrarily-chosen status/id).
    for dupfield, first, second in [("status", "reported", "accepted"), ("id", "F-0001", "F-0002")]:
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(_ledger(
                "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
            if dupfield == "status":
                fm = "id: F-0001\nstatus: reported\nstatus: accepted\n"
            else:
                fm = "id: F-0001\nid: F-0002\npass: P-01\nupdated: 2026-07-21\nstatus: accepted\n"
            (audit / "findings" / "F-0001-a.md").write_text(f"---\n{fm}---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            lint_out = b.getvalue()
            conf = {"batch_size": "8", "triage_batch_cap": "0"}
            _r, _u, _c, kind, _d = state_and_decision(Path(td), conf)
            ok = rc == 1 and "duplicate frontmatter key" in lint_out and kind == "stop-finding-malformed"
            print(f"{'PASS' if ok else 'FAIL'}: duplicate '{dupfield}:' key caught by lint + fails decision closed (F-0103)" + ("" if ok else f" -> rc={rc} kind={kind} {lint_out[:100]}"))
            failed += 0 if ok else 1

    # F-0100: a terminal triage decision (rejected/deferred) with the finding file
    # still `reported` — the writing transaction SYNCS it to the file, and the
    # done-path backstop refuses completion while any such delta is unsynced.
    for decided, done_kind in [("rejected", "done"), ("deferred", "done-deferred-debt")]:
        with tempfile.TemporaryDirectory() as td:
            proj = Path(td)
            audit = proj / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "XCHECK.md").write_text("x", encoding="utf-8")
            complete_audit(audit, queue="## 4. Pass queue\n- [x] P-01 — done\n")
            (audit / "LEDGER.md").write_text(_ledger(
                f"| F-0001 | a | major | {decided} | human | 2026-07-21 |\n"), encoding="utf-8")
            (audit / "findings" / "F-0001-a.md").write_text(
                "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n", encoding="utf-8")
            # backstop: before any sync, the done-path fails closed
            conf = {"batch_size": "8", "triage_batch_cap": "0"}
            _r, _u, _c, kind_pre, _d = state_and_decision(proj, conf)
            # sync applies the decision to the finding file (no pre-session dirt -> nothing
            # mixed; the file was clean, so the sync writes and declares it)
            synced, _mixed = sync_terminal_triage(audit)
            f_after = (audit / "findings" / "F-0001-a.md").read_text(encoding="utf-8")
            # after sync the same state certifies the real terminal/deferred verdict
            _r, _u, _c, kind_post, _d = state_and_decision(proj, conf)
            ok = (kind_pre == "stop-triage-unsynced" and [fid for fid, _ in synced] == ["F-0001"]
                  and f"status: {decided}" in f_after and kind_post == done_kind)
            print(f"{'PASS' if ok else 'FAIL'}: unsynced {decided} triage blocks done, sync applies it to the file (F-0100)" + ("" if ok else f" -> pre={kind_pre} synced={synced} post={kind_post}"))
            failed += 0 if ok else 1

    # F-0100 reopen (Verifier): the terminal-triage sync must never execute a human
    # decision off a structurally ambiguous derived index. F-0001 has TWO ledger
    # rows (accepted then rejected) and a `reported` file: the integrity gate must
    # fire (stop-ledger-duplicate) BEFORE the sync, and the sync itself must no-op
    # on the ambiguous id — the canonical file stays `reported`, never rewritten to
    # the arbitrary last-write-wins status.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"
            "| F-0001 | a | major | rejected | human | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n", encoding="utf-8")
        gate_kind, _gd = ledger_integrity_stop(audit)
        synced, _mixed = sync_terminal_triage(audit)
        f_after = (audit / "findings" / "F-0001-a.md").read_text(encoding="utf-8")
        ok = gate_kind == "stop-ledger-duplicate" and synced == [] and "status: reported" in f_after
        print(f"{'PASS' if ok else 'FAIL'}: duplicate-ledger gate precedes sync; sync no-ops on ambiguous id, file untouched (F-0100)" + ("" if ok else f" -> gate={gate_kind} synced={synced}"))
        failed += 0 if ok else 1

    # F-0015: auditor accuracy denominator = only findings past validation
    def _metrics_out(rows_spec):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(
                _ledger(*(f"| {i} | t | major | {s} | {n} | 2026-07-21 |\n" for i, s, n in rows_spec)), encoding="utf-8")
            for i, s, n in rows_spec:
                (audit / "findings" / f"{i}-x.md").write_text(
                    f"---\nid: {i}\ntitle: t\nseverity: major\ndimension: invariants\nunit: B01\nstatus: {s}\nattempts: 0\npass: P-01\nupdated: 2026-07-21\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                cmd_metrics(Path(td))
            return b.getvalue()
    o_acc = _metrics_out([("F-0001", "rejected", "—"), ("F-0002", "deferred", "human"),
                          ("F-0003", "accepted", "Remediator"), ("F-0004", "disputed", "human"),
                          ("F-0005", "closed", "—")])
    o_acc_na = _metrics_out([("F-0001", "accepted", "Remediator")])
    ok = "auditor accuracy (survived validation): 50.0%" in o_acc and "auditor accuracy (survived validation): n/a" in o_acc_na
    print(f"{'PASS' if ok else 'FAIL'}: auditor accuracy counts only validated pool, n/a when empty (F-0015)" + ("" if ok else f" -> {o_acc[o_acc.find('auditor'):][:60]} | {o_acc_na[o_acc_na.find('auditor'):][:60]}"))
    failed += 0 if ok else 1

    # F-0016: fix durability denominator = verdicts (closed|reopened), numerator = closed@0
    def _dur_out(rows_spec):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(
                _ledger(*(f"| {i} | t | major | {s} | — | 2026-07-21 |\n" for i, s, a in rows_spec)), encoding="utf-8")
            for i, s, a in rows_spec:
                (audit / "findings" / f"{i}-x.md").write_text(
                    f"---\nid: {i}\ntitle: t\nseverity: major\ndimension: invariants\nunit: B01\nstatus: {s}\nattempts: {a}\npass: P-01\nupdated: 2026-07-21\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                cmd_metrics(Path(td))
            return b.getvalue()
    d_mix = _dur_out([("F-0001", "closed", "0"), ("F-0002", "reopened", "0"), ("F-0003", "superseded-by-class", "0")])
    d_reop = _dur_out([("F-0001", "reopened", "0")])
    d_closed = _dur_out([("F-0001", "closed", "0")])
    d_closed1 = _dur_out([("F-0001", "closed", "1")])
    ok = ("fix durability (closed first pass):      50.0%" in d_mix
          and "fix durability (closed first pass):      0.0%" in d_reop
          and "fix durability (closed first pass):      100.0%" in d_closed
          and "fix durability (closed first pass):      0.0%" in d_closed1)
    print(f"{'PASS' if ok else 'FAIL'}: fix durability excludes superseded, reopened=fail, closed@0=success (F-0016)" + ("" if ok else f" -> {[d_mix, d_reop, d_closed, d_closed1]}"))
    failed += 0 if ok else 1

    # F-0017: metrics report total absorbed members of class findings
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | superseded-by-class | — | 2026-07-21 |\n"
            "| F-0002 | b | major | superseded-by-class | — | 2026-07-21 |\n"
            "| CF-0001 | c | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text("---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: superseded-by-class\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "findings" / "F-0002-b.md").write_text("---\nid: F-0002\npass: P-01\nupdated: 2026-07-21\ntitle: b\nseverity: major\ndimension: invariants\nunit: B01\nstatus: superseded-by-class\nattempts: 0\n---\n", encoding="utf-8")

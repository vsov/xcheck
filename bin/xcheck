        failed += 0 if ok else 1

    # F-0013: filename<->id mismatch and duplicate ids are caught; control is clean
    def _lint_out(setup):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            setup(audit)
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            return rc, b.getvalue()

    def _mismatch(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-9999-wrong.md").write_text("---\nid: F-0001\nstatus: accepted\n---\n", encoding="utf-8")

    def _dup(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text("---\nid: F-0001\nstatus: accepted\n---\n", encoding="utf-8")
        (audit / "findings" / "F-0001-b.md").write_text("---\nid: F-0001\nstatus: accepted\n---\n", encoding="utf-8")

    def _control(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")

        # adversarial (Verifier F-0011 reopen): the bare uppercase words in prose
        # must NOT satisfy the gate — a marker is line-anchored, not a mention.
        pf.write_text(
            "This sentence merely mentions COVERED and NOT COVERED without reporting scope.\n",
            encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_prose = cmd_next(proj, conf, dry_run=False)
        # each real Auditor marker style still passes (### / bare COVERED:)
        pf.write_text("### COVERED\na\n### NOT COVERED\nb\n", encoding="utf-8")
        b = _io2.StringIO()

    # F-0043: lint validates a recurrence-of reference (ancestor exists + terminal
    # + single canonical id + shared ledger title, F-0043 re-take RP-0014)
    def _rec(anc_status, ro="F-0001", anc_title="a", new_title="a"):
        def _setup(audit):

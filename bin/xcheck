        print(f"{'PASS' if ok else 'FAIL'}: superseded-by-class certifies 'done' only with a closed CF (F-0050)"
              + ("" if ok else f" -> orphan={k_orphan},{d_orphan} closed={k_closed} rej={k_rej},{d_rej}"))

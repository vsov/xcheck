        # F-0123 re-take (human ruling 2026-07-28): the header must equal all SIX canonical
        # column names IN ORDER, not merely start with `| id | title |`. A real GFM table
        # (matching-width delimiter) whose header is three columns, seven columns, the six
        # names reordered, or one field renamed is a corrupted/substituted index, NOT a legal
        # zero-finding audit — every one must fail lint AND metrics closed.
        schema_poison = [
            ("| id | title | garbage |\n|---|---|---|\n"),                   # three columns
            ("| id | title | severity | status | next | updated | extra |\n"
             "|---|---|---|---|---|---|---|\n"),                            # seven columns
            ("| title | id | severity | status | next | updated |\n"
             "|---|---|---|---|---|---|\n"),                                # six names, wrong order
            ("| id | title | severity | status | next | date |\n"
             "|---|---|---|---|---|---|\n"),                                # one field renamed

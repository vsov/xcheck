    return 1 if failed else 0


# ---------------------------------------------------------------- lint / metrics


# CF-0001 human ruling #6: the four YAML null spellings and an empty value, all meaning
# "no value". The flat frontmatter parser is line-based, so `field: null` would otherwise
# yield the STRING "null" — non-empty, so it slipped past the nullability gate and reached a
# per-field predicate as if a real value (`_canon_unit` read "null" as an addressable path;
# lint clean, metrics clean, decision routed — the round-6 reopen). Every absence spelling in
# a DECLARED form (a scalar, or a scalar element of a flat list) is folded to "" at the SINGLE
# parser input — `_yaml_absent`, applied by `_fm_value` — so the existing shared gate then
# treats them uniformly: legal for a nullable §2 field (`class`/`recurrence-of`/`blocked`/
# `norm-ruling`, written `: null` in real findings), fail-closed for a non-nullable one (`unit`
# etc.). No per-field predicate mentions a YAML spelling — the hole is one place, closed once.
# `_FLOW_MARKS` is how a value that is NOT a declared §2 form is recognised: eight rounds of
# folding absence spellings into ever-deeper nesting proved that set unbounded (a top-level fold
# left `[[null]]` addressable — the round-8 reopen), so the fix is finite — parse only the two
# declared forms and reject everything else as bad-form, rather than normalise arbitrary YAML
# (CF-0001 human ruling #9).
_YAML_NULL = frozenset(("null", "Null", "NULL", "~"))
_FLOW_MARKS = re.compile(r"[\[\]{}]")


def _yaml_absent(s):
    return "" if s in _YAML_NULL else s


def _fm_value(v):
    """A frontmatter value parsed into `(normalized, form_ok)`.

    The parser recognises EXACTLY the two value forms XCHECK.md §2 declares for a
    canonical field: a scalar, or a FLAT inline list of scalars (`[a, b]`). It does
    not try to normalise an arbitrary YAML structure into something addressable —
    eight rounds of chasing absence spellings into ever-deeper nesting proved that
    set is unbounded (CF-0001 human ruling #9). Any value that is not a declared
    form — a flow mapping (`{a: b}`), a nested list (`[[null]]`), or an unclosed
    bracket (`[a`) — is returned with `form_ok=False`, so the shared structural gate
    (`finding_files_malformed`) fails it closed on all three consumers rather than
    reading a mangled value as valid. Only declared forms are parsed; everything
    else is rejected as an invalid form (no claim of normalising "any depth").

    Normalisation applies ONLY to the scalars of a declared form. An inline comment
    (a `#` after whitespace — canonical YAML; `CF-0001#CF-0002` has no separator, so
    the `#...` is PART of the value, F-0043 human ruling #3) is stripped, and a YAML
    null scalar (`null`/`Null`/`NULL`/`~`) is folded to "" — the one input every
    finding value passes through — so no downstream predicate has to know a YAML
    spelling (CF-0001 human ruling #6). A flat inline list folds each element the
    same way, so a list of only null elements collapses to the empty `[]` the
    non-nullable gate rejects (ruling #7)."""
    m = re.search(r"\s#", v)
    s = (v[: m.start()] if m else v).strip()
    if s.startswith("{"):
        return s, False  # a flow mapping is not a declared §2 form
    if s.startswith("["):
        if not s.endswith("]"):
            return s, False  # an unclosed inline list (`[a`) is not a declared form
        elems = [e for e in re.split(r"[,\s]+", s[1:-1].strip()) if e]
        if any(_FLOW_MARKS.search(e) for e in elems):
            return s, False  # a nested list/mapping element (`[[null]]`, `[{a: b}]`)
        kept = [t for t in (_yaml_absent(e) for e in elems) if t]
        return "[" + ", ".join(kept) + "]", True
    return _yaml_absent(s), True


def _parse_frontmatter(block):
    """Parse a finding frontmatter block into (fields, duplicate_keys).

    Frontmatter is a flat YAML mapping — every `key: value` line is a SINGLETON
    (§2 canonical record). The historical loop assigned `fm[key] = value` line by
    line, so a second `status:` (or any repeated key) silently OVERWROTE the
    first and the record parsed to whichever line came LAST — a file physically
    holding two statuses of different owners resolved to one, order-dependently
    (F-0103). Value parsing is unchanged; this additionally records every repeated
    key so callers can fail closed on a corrupted record instead of picking one
    arbitrarily.

    A block YAML list (`unit:` on its own line followed by `  - B01` items) is folded
    into the preceding key as a comma-joined scalar so a list-valued canonical field
    (CF-0001 human ruling #5: `unit` is non-nullable and must name a unit) is NOT stored
    as an empty scalar — otherwise a real multi-unit finding would falsely fail the
    non-nullable gate. Inline lists (`unit: [B01, B02]`) already carry their value on the
    key line and are unaffected.

    A value or block-list element whose FORM is not one XCHECK.md §2 declares — a flow
    mapping, a nested list, an unclosed bracket, a non-scalar block element — is recorded
    as a bad-form field (returned alongside `dups`), so `finding_files_malformed` fails it
    closed on every consumer rather than a downstream predicate reading a mangled value as
    valid (CF-0001 human ruling #9: accept declared forms, do not normalise arbitrary YAML)."""
    fm, dups, seen, badform = {}, [], set(), []
    last_key = None
    for line in block.splitlines():
        item = re.match(r"^\s*-\s+(.*\S)\s*$", line)
        if item and last_key is not None:
            # A block-list element must be a plain scalar (the flat-list form §2 declares).
            # Strip comment + fold YAML-null (ruling #6) as on the scalar path; an element
            # that opens its OWN flow collection (`- [null]`, `- {a: b}`) is a nested
            # structure, not a scalar, so it is bad-form (ruling #9), not normalised.
            cm = re.search(r"\s#", item.group(1))
            e = (item.group(1)[: cm.start()] if cm else item.group(1)).strip()
            if _FLOW_MARKS.search(e):
                badform.append(last_key)
                continue
            val = _yaml_absent(e)
            if val:
                cur = fm.get(last_key, "")
                fm[last_key] = (cur + ", " + val) if cur else val
            continue
        if ":" not in line:
            continue
        k, _, v = line.partition(":")
        k = k.strip()
        if k in seen:
            dups.append(k)
        seen.add(k)
        val, ok = _fm_value(v)
        if not ok:
            badform.append(k)
        fm[k] = val
        last_key = k
    return fm, dups, badform


def load_findings(audit_dir: Path):
    """Parse frontmatter of every findings/*.md -> {id: {field: value}}."""
    out = {}
    fdir = audit_dir / "findings"
    if not fdir.is_dir():
        return out
    for f in sorted(fdir.glob("*.md")):
        text = f.read_text(encoding="utf-8", errors="replace")
        m = re.match(r"^---\n(.*?)\n---", text, re.S)
        if not m:
            continue
        fm, dups, badform = _parse_frontmatter(m.group(1))
        fid = fm.get("id")
        if fid:
            fm["_file"] = f.name
            if dups:
                fm["_dupkeys"] = dups  # F-0103
            if badform:
                fm["_badform"] = badform  # CF-0001 ruling #9
            out[fid] = fm
    return out


def load_finding_files(audit_dir: Path):
    """Every findings/*.md with its own frontmatter, WITHOUT collapsing by id.

    `load_findings` returns {id: fm}, so two files sharing an id or a file whose
    name prefix disagrees with its frontmatter id both vanish into one entry —
    hiding exactly the `<id>-*.md` one-file-one-finding contract lint must check
    (F-0013). This preserves one dict per physical file (each with `_file`)."""
    out = []
    fdir = audit_dir / "findings"
    if not fdir.is_dir():
        return out
    for f in sorted(fdir.glob("*.md")):
        text = f.read_text(encoding="utf-8", errors="replace")
        m = re.match(r"^---\n(.*?)\n---", text, re.S)
        if not m:
            # A findings/*.md with NO frontmatter block still exists on disk and
            # must not vanish before the orphan/id checks (F-0013): record it as
            # malformed so lint reports it instead of silently skipping.
            out.append({"_file": f.name, "_malformed": True})
            continue
        fm, dups, badform = _parse_frontmatter(m.group(1))
        fm["_file"] = f.name
        if dups:
            fm["_dupkeys"] = dups  # F-0103
        if badform:
            fm["_badform"] = badform  # CF-0001 ruling #9
        out.append(fm)
    return out


def finding_files_malformed(audit_dir: Path):
    """(file, reason) for every findings/*.md whose canonical record is
    STRUCTURALLY ambiguous — the decision path must never route a role off such a
    file (§2: the finding file is the single source of truth). Three cases:
      * no frontmatter block at all (F-0013);
      * a duplicated top-level singleton key — two `status:` / `id:` lines etc.
        that last-wins parsing would silently collapse to one (F-0103); and
      * a canonical field whose FORM is not one XCHECK.md §2 declares — a nested
        list, a flow mapping, an unclosed bracket, a non-scalar block element —
        which a downstream predicate would otherwise read as a mangled but valid
        value (CF-0001 human ruling #9)."""
    out = []
    for fm in load_finding_files(audit_dir):
        if fm.get("_malformed"):
            out.append((fm["_file"], "no frontmatter block"))
        elif fm.get("_dupkeys"):
            keys = ", ".join(sorted(set(fm["_dupkeys"])))
            out.append((fm["_file"], f"duplicate frontmatter key(s): {keys}"))
        elif fm.get("_badform"):
            fields = ", ".join(sorted(set(fm["_badform"])))
            out.append((fm["_file"], f"canonical field(s) {fields} are not a declared §2 form (a scalar or a flat list of scalars); a nested list, flow mapping, or unclosed bracket is invalid (CF-0001 human ruling #9)"))
    return out


FNAME_ID_RE = re.compile(r"^((?:F|CF)-\d{4})-")
CANONICAL_NEXT = {"Planner", "Auditor", "Triage", "Remediator", "Verifier", "human", "—", "-"}
NEEDS_HUMAN_NEXT_RE = re.compile(r"^(?:human\s+)?⚠ needs-human$")

TERMINAL_OR_DEFERRED = TERMINAL | {"deferred"}

# F-0102: `next` is not merely a known token (F-0014) — it names the OWNER of the
# finding's CURRENT lifecycle status (§2: "whichever role or the human is expected
# to act on the finding next"; §5 one-status/one-owner). This maps each status to
# the actor(s) legally expected next, so a syntactically valid role on the wrong
# status (e.g. `Verifier` on a `reported` row that still needs human triage, or
# `human` on a terminal `closed` row) is caught instead of passing as canonical.
# Terminal states expect `—`/`-` (no next actor). `superseded-by-class` is NOT in
# this map: its terminality is CONDITIONAL (member of a closed CF or not), so the
# caller COMPUTES it via `superseded_terminal` (F-0102 reopen — excluding the whole
# status let a member of a CLOSED CF carry a foreign role and still pass). A legal
# pending-triage delta and the `⚠ needs-human` exception are skipped by the caller
# before this map is consulted.
NEXT_OWNER = {
    "reported": {"Triage", "human"},
    "accepted": {"Remediator"},
    "validated": {"Remediator"},
    "planned": {"Remediator"},
    "reopened": {"Remediator"},
    "fixed": {"Verifier"},
    "disputed": {"Auditor", "human"},
    "deferred": {"Triage", "human"},
    "closed": {"—", "-"},
    "rejected": {"—", "-"},
    "withdrawn": {"—", "-"},
    "obsolete": {"—", "-"},
}


def next_owners(fid, status, fnd):
    """The set of actors that legally own `next` for a finding in `status` (§2/§5),
    or None when the status has no fixed owner to check. `superseded-by-class` is
    CONDITIONAL (F-0102 reopen): a member of a CLOSED CF is terminal (owner `—`/`-`),
    an unabsorbed member's fate follows its CF (left unchecked → None). Every other
    status maps through the single NEXT_OWNER constant, so the pending-triage
    owner-check (CF-0001 I-4) and the plain owner-check share one definition."""
    if status == "superseded-by-class":
        return {"—", "-"} if superseded_terminal(fid, fnd) else None
    return NEXT_OWNER.get(status)


def cmd_lint(project: Path):
    """Read-only ledger<->finding-file consistency check (B2). Exit 1 on issues."""
    audit = project / "audit"
    # F-0004/F-0123: a missing, empty, or headerless ledger is not "clean" — the
    # consistency check has no valid input. One structural gate (shared with the
    # decision/metrics integrity gate) fails closed on all three; a valid
    # header+separator with zero rows stays a legal empty audit.
    structure = ledger_structure_issue(audit)
    if structure:
        print(f"xcheck lint: {structure}")
        return 1
    rows = {r["id"]: r for r in parse_ledger(audit)}
    fnd = load_findings(audit)
    issues = []

    # F-0043/F-0050: `class:` is a canonical single-id field (§2: `null | CF-NNNN`),
    # parsed fail-CLOSED by the shared module-level `sole_cf` — the WHOLE stripped
    # value must be exactly one `CF-NNNN`, else it names no valid CF. A loose
    # first-match search let `junk-CF-0001`, `CF-0001-junk`, and ambiguous
    # `CF-0001 CF-0002` slip through, arbitrarily picking the first id (RP-0016).
    _sole_cf = sole_cf

    # F-0004: table lines that don't parse as a row are silently dropped by the
    # ledger parser; surface them instead of reporting a false 'clean'.
    for ml in ledger_malformed_rows(audit):
        issues.append(f"malformed ledger line (not a valid finding row): {ml!r}")

    # F-0097: `rows` above collapses the ledger by id, so two rows for one id
    # vanish into one and lint reported a false 'clean' over a finding carrying
    # two statuses. Surface the duplicates from the RAW row list (§2: one row per
    # finding). ledger_duplicate_ids re-scans the same file.
    _raw_rows = parse_ledger(audit)
    for dup in ledger_duplicate_ids(audit):
        n = sum(1 for r in _raw_rows if r["id"] == dup)
        issues.append(f"{dup}: appears on {n} LEDGER rows — LEDGER is a derived index, one row per finding (§2)")

    # CF-0001: §2 canonical-record VALUE violations, through the SAME schema-driven
    # predicate the decision-path integrity gate and metrics use (canonical_record_issues)
    # — so a value outside the §2/§5 vocabulary, a bad attempts, an empty required field,
    # etc. can no longer be certified 'clean' here while `decide`/`metrics` read it as
    # valid (the class root cause, F-0055 line).
    for it in canonical_record_issues(audit):
        issues.append(it)

    # CF-0001 re-take round 3: `next` owner-CONSISTENCY (F-0014/F-0102/I-4) is a
    # lint-surface check (not read by the router), the complement of the value-validity
    # `next_value_issues` already folded into canonical_record_issues above.
    for it in next_owner_issues(audit):
        issues.append(it)

    # CF-0001 re-take (meta-check, human ruling point 3): bind the code's schema table
    # to the §2 prose in this project's audit/XCHECK.md — a field declared in §2 with no
    # validator, or a validator for a field §2 dropped, is drift lint must surface. This
    # is what makes 'add a field to §2 without a validator' impossible (the F-0077 close).
    for it in canonical_schema_meta_issues(audit / "XCHECK.md"):
        issues.append(it)

    for fid, r in rows.items():
        fm = fnd.get(fid)
        if fm is None:
            issues.append(f"{fid}: ledger row has no findings/ file")
            continue
        fstatus = fm.get("status", "")
        # ledger vs frontmatter status: equal, or one of the TWO legal
        # pending-triage deltas of §2 rule 3 — judged by the single shared
        # `pending_triage_delta` (F-0099), so lint and effective_rows can never
        # disagree on what is legal. Anything else is a real ledger/file
        # disagreement (§2: the finding file is the source of truth).
        _pending = pending_triage_delta(fstatus, r["status"], fm, fnd)
        if r["status"] != fstatus and not _pending:
            issues.append(f"{fid}: ledger status '{r['status']}' != frontmatter '{fstatus}' (not a pending-triage delta)")
        # F-0101: title and severity are canonical in the finding file (§2: the
        # file is the single source of truth; the ledger is a derived index, not a
        # second copy). A derived value that disagrees is drift lint must SURFACE,
        # not report 'clean' over — severity drives triage presentation and KPIs,
        # title drives the Auditor's mandatory dedup.
        # F-0101 reopen / CF-0001 human ruling #4: both are REQUIRED, NON-nullable
        # canonical frontmatter (§2). PRESENCE is now owned by the shared gate
        # (`canonical_record_issues` above, via the non-nullable schema entry), so a
        # missing/empty field fails closed on lint AND the decision path AND metrics —
        # single source, no per-consumer presence check to drift. Here only the
        # DRIFT (ledger disagrees with a PRESENT frontmatter value) is a lint-surface
        # concern the router does not read.
        ftitle = fm.get("title", "").strip()
        if ftitle and r["title"] != ftitle:
            issues.append(f"{fid}: ledger title '{r['title']}' != frontmatter '{ftitle}' (§2: the finding file is the source of truth)")
        fsev = fm.get("severity", "").strip()
        if fsev and r["severity"] != fsev:
            issues.append(f"{fid}: ledger severity '{r['severity']}' != frontmatter '{fsev}' (§2: the finding file is the source of truth)")
        # F-0014/F-0102/CF-0001 I-4/I-5: the `next` control-column check (canonical
        # vocabulary, the `⚠ needs-human` binding, pending-triage owner union, and the
        # plain status-owner check) now lives in the SHARED `ledger_next_issues`, folded
        # into canonical_record_issues (surfaced above) so it fails closed BEFORE routing
        # and metrics, not only here (CF-0001 re-take round 3: `next` is a control column
        # that must pass the shared gate like `status`).
        # F-0096: writer-boundary check on the `fixed-by` provenance. A `fixed`
        # finding must carry a canonical session id (16 lowercase hex) or the
        # Verifier ≠ fixer gate cannot be proven and refuses to route it (§3).
        # Surface a missing/malformed token here, at the writing boundary, rather
        # than only stalling the cycle at dispatch.
        if fstatus == "fixed":
            fb = (fm.get("fixed-by") or "").strip()
            if not fb:
                issues.append(f"{fid}: status 'fixed' but no `fixed-by` provenance (F-0096) — verification is refused without it (§3)")
            elif not is_session_id(fb):
                issues.append(f"{fid}: `fixed-by` '{fb}' is not a canonical session id (16 lowercase hex) (F-0096)")

    # F-0013 / F-0103 / CF-0001: file-level id integrity on the RAW files
    # (load_findings collapses them by id, so it cannot see a mismatch or a duplicate).
    # Every check comes from the SAME predicate the decision-path integrity gate uses —
    # no frontmatter / duplicate singleton keys (finding_files_malformed), missing id or
    # filename/id mismatch (finding_files_id_issues, CF-0001 I-8/I-9), and duplicate ids
    # (finding_files_duplicate_ids, CF-0001 I-3) — so lint and `next`/`loop`/`metrics`
    # can never disagree on what counts as a broken record.
    id_counts = {}
    for fm in load_finding_files(audit):
        _fid = fm.get("id")
        if _fid:
            id_counts[_fid] = id_counts.get(_fid, 0) + 1
    for fname, reason in finding_files_malformed(audit):
        issues.append(f"{fname}: {reason} (F-0013/F-0103) — invisible to id/orphan checks; a role must never be routed off an arbitrarily-chosen status/id (§2)")
    for fname, reason in finding_files_id_issues(audit):
        issues.append(f"{fname}: {reason}")
    for dfid in finding_files_duplicate_ids(audit):
        issues.append(f"{dfid}: {id_counts.get(dfid, 0)} finding files share this id (exactly one <id>-*.md required)")

    for fid in fnd:
        if fid not in rows:
            issues.append(f"{fid}: findings/ file has no ledger row (orphan)")

    # class-membership integrity
    for fid, fm in fnd.items():
        if fid.startswith("CF-"):
            # F-0012: a member's legal status depends on the CF's own status. A
            # LIVE CF absorbs members into superseded-by-class (later closed). A
            # REJECTED CF reverts members to accepted for point fixes (§8 rule 4,
            # §5 superseded-by-class → accepted) — that reverted 'accepted' is
            # the normative post-rejection state, not a lint error.
            cf_rejected = fm.get("status") == "rejected"
            allowed = ("superseded-by-class", "closed") + (("accepted",) if cf_rejected else ())
            # F-0050: canonical list-element parse, not a substring search. A
            # non-canonical entry (`F-00010`, `junk-F-0001-junk`) is flagged as
            # corrupt rather than silently mining a shorter id out of it.
            members, bad_members = parse_members(fm.get("members", ""))
            for bm in bad_members:
                issues.append(f"{fid}: members entry '{bm}' is not a canonical F-NNNN/CF-NNNN id")
            for mid in members:
                if mid not in fnd:
                    issues.append(f"{fid}: member {mid} does not exist")
                elif fnd[mid].get("status") not in allowed:
                    issues.append(f"{fid}: member {mid} status '{fnd[mid].get('status')}' not {'/'.join(allowed)}")
        cls = fm.get("class", "")
        if fm.get("status") == "superseded-by-class":
            cf = _sole_cf(cls)
            if not cf:
                issues.append(f"{fid}: superseded-by-class but no class: CF-xxxx in frontmatter")
            elif cf not in fnd:
                issues.append(f"{fid}: class {cf} does not exist")
            elif fid not in parse_members(fnd[cf].get("members", ""))[0]:
                issues.append(f"{fid}: not listed in {cf} members")

    # F-0042: a CF blocked at the §8 norm-ratification gate must carry a
    # syntactically valid `norm-ruling` (the fail-closed machine gate). Valid =
    # `pending` or a norm-id token (N1 / N1-over-N4); a missing/empty field or a
    # garbage token is a corrupt gate — flag it so the pair can't silently rot.
    for fid, fm in fnd.items():
        if fm.get("blocked") == "norm-ratification":
            nr = (fm.get("norm-ruling") or "").strip()
            if not nr:
                issues.append(f"{fid}: blocked: norm-ratification requires a 'norm-ruling' field (pending or a norm-id; §8 machine gate)")
            elif nr.lower() != "pending" and not NORM_RULING_TOKEN_RE.match(nr):
                issues.append(f"{fid}: norm-ruling '{nr}' is neither 'pending' nor a norm-id token (e.g. N1 / N1-over-N4); §8 gate corrupt")

    # F-0043: a recurrence finding names its terminal ancestor via `recurrence-of`
    # (human ruling option a: terminal stays terminal, the recurrence is a NEW
    # finding). The reference must resolve to an existing, TERMINAL ancestor — a
    # live (non-terminal) target is an ordinary dedup, not a recurrence.
    # Terminality is CONTEXTUAL for `superseded-by-class` (§3 dedup): a member is
    # terminal only when its CF is closed; a member of a still-open CF is
    # non-terminal, so a `recurrence-of` pointing at it is an ordinary dedup that
    # must reject — not a valid recurrence ancestor. The member's `class:` link is
    # read fail-CLOSED via `_sole_cf` (re-take RP-0016): a non-canonical value
    # (`junk-CF-0001`, `CF-0001-junk`, ambiguous `CF-0001 CF-0002`) names no CF, so
    # terminality can't be established and the recurrence rejects — a loose
    # first-match search arbitrarily picked the first id and passed these.
    # Two provenance invariants close the remaining holes (F-0043 re-take RP-0014):
    #   (1) the WHOLE value must be exactly one canonical id — a loose search let
    #       `junk-F-0001`, `F-0001-junk`, or two ids `F-0001 CF-9999` slip through;
    #   (2) a recurrence is DETECTED by a ledger-title match with its terminal
    #       ancestor (§3 dedup), so the claimed ancestor must actually share this
    #       finding's title — otherwise a new finding could pin any unrelated
    #       terminal id as its provenance, breaking file provenance and the
    #       class_threshold count.
    for fid, fm in fnd.items():
        ro = (fm.get("recurrence-of") or "").strip()
        if not ro or ro.lower() in ("null", "none"):
            continue
        if not re.fullmatch(r"(?:F|CF)-\d{4}", ro):
            issues.append(f"{fid}: recurrence-of '{ro}' is not a single F-NNNN/CF-NNNN id")
            continue
        aid = ro
        if aid not in fnd:
            issues.append(f"{fid}: recurrence-of {aid} does not exist")
            continue
        anc_status = fnd[aid].get("status")
        if anc_status in HARD_TERMINAL:
            terminal = True
        elif anc_status == "superseded-by-class":
            cf = _sole_cf(fnd[aid].get("class"))
            terminal = bool(cf and fnd.get(cf, {}).get("status") == "closed")
        else:
            terminal = False
        if not terminal:
            issues.append(f"{fid}: recurrence-of {aid} is '{anc_status}', not terminal — a recurrence targets only a terminal ancestor (superseded-by-class counts only with a closed CF)")
            continue
        # A recurrence is a title match on its terminal ancestor (§3 dedup); the
        # `recurrence-of` id must belong to a finding that actually carries the
        # same ledger title (orphan findings — absent from `rows` — are already
        # flagged separately, so only cross-check when both rows exist).
        if fid in rows and aid in rows:
            new_title = (rows[fid].get("title") or "").strip()
            anc_title = (rows[aid].get("title") or "").strip()
            if new_title != anc_title:
                issues.append(f"{fid}: recurrence-of {aid} title '{anc_title}' != this finding's title '{new_title}' — a recurrence must share its terminal ancestor's title (§3 dedup)")

    # F-0043 (human ruling #2): `recurrence-of` must form an ACYCLIC chain toward a
    # terminal ancestor. A self-reference (recurrence-of on itself) or any cycle in
    # the directed graph finding→recurrence-of has no terminal root, so the
    # provenance and the class_threshold count become fiction. A bare `aid != fid`
    # check is NOT enough — it still admits the two-node cycle A→B→A — so walk each
    # chain and flag the first revisit.
    def _ro_edge(f):
        v = (fnd.get(f, {}).get("recurrence-of") or "").strip()
        return v if re.fullmatch(r"(?:F|CF)-\d{4}", v) and v in fnd else None
    for fid in fnd:
        chain, cur = [fid], _ro_edge(fid)
        while cur is not None:
            if cur in chain:
                issues.append(f"{fid}: recurrence-of forms a cycle ({' → '.join(chain + [cur])}) — a recurrence must resolve to a terminal ancestor, never back to itself (§3 dedup)")
                break
            chain.append(cur)
            cur = _ro_edge(cur)

    if issues:
        print(f"xcheck lint: {len(issues)} issue(s)")
        for it in issues:
            print(f"  ✗ {it}")
        return 1
    print(f"xcheck lint: clean ({len(rows)} rows, {len(load_finding_files(audit))} finding files)")
    return 0


def cmd_metrics(project: Path):
    """Read-only spec §11 metrics from ledger + finding frontmatter (B3)."""
    audit = project / "audit"
    # CF-0001 reopen: metrics is an authoritative CONSUMER of the canonical record,
    # so it must fail closed on the SAME single integrity gate the decision path runs
    # BEFORE reconciling rows — never publish KPIs over a collapsed/invalid record it
    # read PAST the validator (the class root, F-0055). This one call subsumes the old
    # standalone enum check and closes the two holes the reopen found: metrics used to
    # publish KPIs over a duplicate-id survivor (I-3, load_findings collapses it) and
    # over an empty canonical `status` substituted from the derived ledger (§2/§8 r5).
    kind, detail = ledger_integrity_stop(audit)
    if kind:
        print("metrics unavailable: durable state failed the canonical-record integrity gate — a KPI computed over a corrupt or invalid record is meaningless (§2). Repair, then re-run:")
        report_gate(kind, detail)
        return 1
    # F-0005: KPIs must reflect the source of truth (finding files for non-triage
    # statuses), not a stale derived ledger. Reconcile before counting.
    raw = {r["id"]: r["status"] for r in parse_ledger(audit)}
    rows, fnd = effective_rows(audit)
    # F-0101 reopen / CF-0001 human ruling #4: `severity`, `title`, `pass`, `updated`
    # are REQUIRED, NON-nullable canonical fields (§2). Presence is now enforced by the
    # SAME `ledger_integrity_stop` -> `canonical_record_issues` gate run above (the
    # schema marks them non-nullable), so an empty/missing one fails closed here BEFORE
    # any KPI is computed — no standalone per-field presence check that could drift from
    # the shared validator (the class root: a consumer reading a canonical field past the
    # gate). The old `missing_sev` block was that drift and is removed.
    drift = [r["id"] for r in rows if raw.get(r["id"]) != r["status"]]
    if drift:
        print(f"note: {len(drift)} LEDGER row(s) out of sync with finding files — "
              f"KPIs computed from frontmatter (§9.4): {', '.join(sorted(drift))}")
    total = len(rows)
    by_status, by_dim, by_sev = {}, {}, {}
    attempts_hist = {}
    for r in rows:
        by_status[r["status"]] = by_status.get(r["status"], 0) + 1
        by_sev[r["severity"]] = by_sev.get(r["severity"], 0) + 1
        fm = fnd.get(r["id"], {})
        d = fm.get("dimension", "?")
        by_dim[d] = by_dim.get(d, 0) + 1
        a = fm.get("attempts", "0")
        attempts_hist[a] = attempts_hist.get(a, 0) + 1

    # auditor accuracy (F-0015): % of findings that actually REACHED validation
    # which survived it. The denominator is only findings past validation — the
    # post-validation states (validated/planned/fixed/closed/reopened) plus the
    # ones validation killed (disputed/obsolete/withdrawn). 'accepted' is
    # pre-validation, 'rejected'/'deferred' never reached validation, 'reported'
    # was never triaged; none of them belong in the denominator (they used to
    # inflate it). 'superseded-by-class' is not an individual validation verdict —
    # excluded. F-0061: 'withdrawn' is the terminal state of a finding that did NOT
    # survive validation (a 'disputed' finding resolved against the Auditor, §5);
    # dropping it from BOTH numerator and denominator turned a real 50% accuracy
    # into 100% and could falsely clear the >80 target.
    VALIDATION_SURVIVED = ("validated", "planned", "fixed", "closed", "reopened")
    VALIDATION_KILLED = ("disputed", "obsolete", "withdrawn")
    validated_pool = [r for r in rows if r["status"] in VALIDATION_SURVIVED or r["status"] in VALIDATION_KILLED]
    survived = [r for r in validated_pool if r["status"] in VALIDATION_SURVIVED]
    acc = (100 * len(survived) / len(validated_pool)) if validated_pool else None
    # fix durability (F-0016): of findings that reached a Verifier VERDICT
    # (closed | reopened — 'superseded-by-class' is not a verdict on the fix),
    # the share CLOSED on the first pass (closed AND attempts 0). 'reopened' is a
    # failed verdict, never a first-pass success; a nonzero attempts closed is
    # not first-pass either.
    reached = [r for r in rows if r["status"] in ("closed", "reopened")]
    first_pass = [r for r in reached if r["status"] == "closed"
                  and fnd.get(r["id"], {}).get("attempts", "0") == "0"]
    dur = (100 * len(first_pass) / len(reached)) if reached else None
    passes_done = len(parse_queue(audit)[1])
    missing_cov = passes_without_coverage(audit)  # F-0011
    cfs = [fid for fid in fnd if fid.startswith("CF-")]
    # F-0017, F-0050, F-0125: DISTINCT member finding ids across all CFs — N7's
    # `total members` is the count of member findings, not repetitions of one id. A
    # duplicate/shared id would already have failed the integrity gate above (metrics
    # never reaches here over one), so on valid data this equals the naive sum.
    cf_members = len({m for cf in cfs for m in parse_members(fnd[cf].get("members", ""))[0]})

    def _pct(v):
        return f"{v:.1f}%" if v is not None else "n/a (no findings reached this stage)"

    print(f"project: {project}")
    print(f"passes done: {passes_done}")
    # F-0011: a bare 'passes done' count hides checked passes with no coverage
    # report; surface the silent gap explicitly.
    print(f"passes without coverage report: {len(missing_cov)}"
          + (f" ({', '.join(missing_cov)})" if missing_cov else ""))
    print(f"findings: {total} total")
    print("  by status:    " + ", ".join(f"{k}:{v}" for k, v in sorted(by_status.items())))
    print("  by severity:  " + ", ".join(f"{k}:{v}" for k, v in sorted(by_sev.items())))
    print("  by dimension: " + ", ".join(f"{k}:{v}" for k, v in sorted(by_dim.items())))
    print(f"class findings: {len(cfs)} ({', '.join(cfs) or 'none'}), total members: {cf_members}")
    print(f"attempts distribution: " + ", ".join(f"{k}x:{v}" for k, v in sorted(attempts_hist.items())))
    print(f"auditor accuracy (survived validation): {_pct(acc)}  (target >80)")
    print(f"fix durability (closed first pass):      {_pct(dur)}  (target >90)")
    return 0


# ---------------------------------------------------------------- main


def parse_budget(raw):
    """Parse a `--budget SECONDS` value into a usable wall-clock cap (F-0062).

    `float()` accepts `nan`/`inf` and negative numbers, but the loop's only test
    is `elapsed >= budget` (cmd_loop): `elapsed >= nan` and `elapsed >= inf` are
    never true, so a non-finite budget SILENTLY disables the advertised cap and
    the loop runs bounded only by `--max-sessions`. Reject non-finite and negative
    durations with an addressed error; `0` stays legal (stops the loop at once)."""
    try:
        v = float(raw)
    except (TypeError, ValueError):
        raise SystemExit(f"--budget must be a number of seconds, got {raw!r}")
    if not math.isfinite(v) or v < 0:
        raise SystemExit(f"--budget must be a finite, non-negative number of seconds, got {raw!r}")
    return v


# F-0090: which command(s) actually CONSUME each flag (N8 grammar in the module
# docstring). `--project` is universal (omitted). The parser used to accept every
# flag regardless of command and the dispatch silently dropped the ones a command
# does not read (`--budget 0 next` parsed but never reached cmd_next); an
# inapplicable flag is now an addressed error, not a silent no-op.
FLAG_COMMANDS = {
    "--dry-run": {"next", "loop"},
    "--step": {"loop"},
    "--max-sessions": {"loop"},
    "--budget": {"loop"},
    "--force": {"unlock"},
}


def main(argv):
    args = list(argv[1:])
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if args[0] == "selftest":
        # F-0019: reject a trailing tail so a typo/glued token can't ride
        # along and still report PASS with exit 0.
        if len(args) > 1:
            raise SystemExit(f"selftest takes no arguments (got: {' '.join(args[1:])})")
        return selftest()

    project = Path.cwd()
    dry_run = False
    step = False
    max_sessions = None
    budget = None
    force = False
    cmd = None
    seen_flags = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--project":
            # F-0121: a value-taking option at the END of argv read args[i] past the
            # list and crashed with a raw IndexError traceback. Bound the read and turn
            # a missing value into an addressed CLI error (the N8 grammar: DIR/N/SECONDS).
            i += 1
            if i >= len(args):
                raise SystemExit(f"{a} requires a DIR value (see --help)")
            project = Path(args[i]).resolve()
        elif a == "--dry-run":
            dry_run = True
            seen_flags.append(a)
        elif a == "--step":
            step = True
            seen_flags.append(a)
        elif a == "--max-sessions":
            i += 1
            if i >= len(args):
                raise SystemExit(f"{a} requires an N value (see --help)")
            # F-0121: a bare int() dumped a raw ValueError on `--max-sessions banana`;
            # convert it to an addressed error naming the option, like every other
            # CLI-value contract (parse_budget, conf_int).
            try:
                max_sessions = int(args[i])
            except ValueError:
                raise SystemExit(f"{a} must be an integer, got {args[i]!r} (see --help)")
            seen_flags.append("--max-sessions")
        elif a == "--budget":
            i += 1
            if i >= len(args):
                raise SystemExit(f"{a} requires a SECONDS value (see --help)")
            budget = parse_budget(args[i])  # already addressed on a non-number (F-0062)
            seen_flags.append("--budget")
        elif a == "--force":
            force = True
            seen_flags.append(a)
        elif a in ("next", "loop", "status", "unlock", "lint", "metrics"):
            # F-0019: a second command word must not silently overwrite the
            # first — the declared grammar is one command per invocation.
            if cmd is not None:
                raise SystemExit(f"multiple commands: {cmd!r} and {a!r} (only one allowed)")
            cmd = a
        else:
            raise SystemExit(f"unknown arg: {a} (see --help)")
        i += 1

    # F-0090: a flag is legal only for the command(s) that consume it (N8). Reject
    # an inapplicable flag with an addressed error instead of silently ignoring it
    # (e.g. `--budget 0 next` parsed but never reached cmd_next; `--force metrics`
    # did nothing). Duplicate flags collapse via the set — order-independent.
    for flag in dict.fromkeys(seen_flags):
        allowed = FLAG_COMMANDS[flag]
        if cmd not in allowed:
            where = f"command {cmd!r}" if cmd else "no command"
            raise SystemExit(
                f"{flag} is not valid for {where} (only: {', '.join(sorted(allowed))})")

    audit = project / "audit"
    if cmd != "unlock" and not (audit / "XCHECK.md").is_file():
        raise SystemExit(f"{audit}/XCHECK.md not found — install xcheck first (bootstrap.md)")
    # F-0009: do NOT persist the default orchestrator.conf here — that write
    # must live inside cmd_next's lock, or a concurrent `next` aborting on a
    # live foreign lock still writes it (a write outside the critical section,
    # violating §4's one-writer serialization). Load for the decision only.
    conf = load_conf(audit) if cmd != "unlock" else {}
    # F-0018: max_sessions is consumed ONLY by `loop`. Resolving it here, before
    # dispatch, made every read-only command (status/lint/metrics) crash with a
    # raw traceback on a malformed orchestrator.conf value. Defer the conf-derived
    # coercion into the loop branch and turn a bad value into an addressed error.

    if cmd == "status":
        cmd_status(project, conf)
    elif cmd == "next":
        # F-0108 reopen: cmd_next converts a session error (spawn failure or a
        # non-zero child exit) into the string "stop-error" and prints the addressed
        # halt, but the CLI boundary discarded that return and fell through to
        # `return 0` — so a caller/CI saw success despite the halt. Propagate it to a
        # NON-ZERO exit so the README §8 session-error contract reaches the exit code,
        # not only stdout. Legitimate gates (triage/done/norm-ratification/coverage/…)
        # are normal stops and keep exit 0.
        kind = cmd_next(project, conf, dry_run)
        if kind == "stop-error":
            return 1
    elif cmd == "loop":
        if max_sessions is None:
            # F-0113: validated at the load_conf boundary — this read returns an
            # already-validated int (a bad value became an addressed error on access,
            # not a raw traceback). status/lint/metrics never reach this branch, so a
            # malformed max_sessions never crashes a read-only command (F-0018).
            max_sessions = int(conf["max_sessions"])
        # F-0122: `loop` is the primary automated route; a session error inside it must
        # reach the shell/CI exit code, not look like success. cmd_loop returns the
        # terminal kind — propagate "stop-error" to a NON-ZERO exit like the `next`
        # branch (README §8 session-error contract). Every other stop is a normal exit 0.
        kind = cmd_loop(project, conf, dry_run, step, max_sessions, budget)
        if kind == "stop-error":
            return 1
    elif cmd == "unlock":
        cmd_unlock(project, force)
    elif cmd == "lint":
        return cmd_lint(project)
    elif cmd == "metrics":
        return cmd_metrics(project)
    else:
        raise SystemExit("no command (next|loop|status|unlock|lint|metrics|selftest)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

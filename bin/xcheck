    # adversarial (Verifier F-0013 reopen): a finding file with valid frontmatter
    # but NO `id` was counted-but-unchecked and passed as clean. It must be flagged.
    def _noid(audit):
        (audit / "LEDGER.md").write_text(_ledger(""), encoding="utf-8")
        (audit / "findings" / "F-0001-no-id.md").write_text("---\nstatus: accepted\n---\n", encoding="utf-8")

    rc1, o1 = _lint_out(_mismatch)
    rc2, o2 = _lint_out(_dup)
    rc3, o3 = _lint_out(_control)
    rc4, o4 = _lint_out(_noid)
    ok = (rc1 == 1 and "F-9999" in o1 and "!= frontmatter id" in o1
          and rc2 == 1 and "share this id" in o2
          and rc3 == 0 and "clean" in o3
          and rc4 == 1 and "no 'id'" in o4)
    print(f"{'PASS' if ok else 'FAIL'}: lint catches filename/id mismatch + duplicate id + missing id, control clean (F-0013)" + ("" if ok else f" -> {rc1}/{o1[:60]} | {rc2}/{o2[:60]} | {rc3} | {rc4}/{o4[:60]}"))
    failed += 0 if ok else 1

    # F-0014: `next` is a fixed vocabulary, not any string containing needs-human
    def _next_case(val):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(_ledger(f"| F-0001 | a | major | accepted | {val} | 2026-07-21 |\n"), encoding="utf-8")
            (audit / "findings" / "F-0001-a.md").write_text("---\nid: F-0001\nstatus: accepted\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            return rc
    reject_vals = ["garbage needs-human garbage", "", "⚠ needs-human extra"]
    accept_vals = ["⚠ needs-human", "human ⚠ needs-human", "Remediator", "human", "—"]
    ok = all(_next_case(v) == 1 for v in reject_vals) and all(_next_case(v) == 0 for v in accept_vals)
    print(f"{'PASS' if ok else 'FAIL'}: lint validates next vocabulary strictly (F-0014)" + ("" if ok else " -> " + str([(v, _next_case(v)) for v in reject_vals + accept_vals])))
    failed += 0 if ok else 1

    # F-0015: auditor accuracy denominator = only findings past validation
    def _metrics_out(rows_spec):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(
                _ledger(*(f"| {i} | t | major | {s} | {n} | 2026-07-21 |\n" for i, s, n in rows_spec)), encoding="utf-8")
            for i, s, n in rows_spec:
                (audit / "findings" / f"{i}-x.md").write_text(
                    f"---\nid: {i}\ntitle: t\nseverity: major\nstatus: {s}\nattempts: 0\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                cmd_metrics(Path(td))
            return b.getvalue()
    o_acc = _metrics_out([("F-0001", "rejected", "—"), ("F-0002", "deferred", "human"),
                          ("F-0003", "accepted", "Remediator"), ("F-0004", "disputed", "human"),
                          ("F-0005", "closed", "—")])
    o_acc_na = _metrics_out([("F-0001", "accepted", "Remediator")])
    ok = "auditor accuracy (survived validation): 50.0%" in o_acc and "auditor accuracy (survived validation): n/a" in o_acc_na
    print(f"{'PASS' if ok else 'FAIL'}: auditor accuracy counts only validated pool, n/a when empty (F-0015)" + ("" if ok else f" -> {o_acc[o_acc.find('auditor'):][:60]} | {o_acc_na[o_acc_na.find('auditor'):][:60]}"))
    failed += 0 if ok else 1

    # F-0016: fix durability denominator = verdicts (closed|reopened), numerator = closed@0
    def _dur_out(rows_spec):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(
                _ledger(*(f"| {i} | t | major | {s} | — | 2026-07-21 |\n" for i, s, a in rows_spec)), encoding="utf-8")
            for i, s, a in rows_spec:
                (audit / "findings" / f"{i}-x.md").write_text(
                    f"---\nid: {i}\ntitle: t\nseverity: major\nstatus: {s}\nattempts: {a}\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                cmd_metrics(Path(td))
            return b.getvalue()
    d_mix = _dur_out([("F-0001", "closed", "0"), ("F-0002", "reopened", "0"), ("F-0003", "superseded-by-class", "0")])
    d_reop = _dur_out([("F-0001", "reopened", "0")])
    d_closed = _dur_out([("F-0001", "closed", "0")])
    d_closed1 = _dur_out([("F-0001", "closed", "1")])
    ok = ("fix durability (closed first pass):      50.0%" in d_mix
          and "fix durability (closed first pass):      0.0%" in d_reop
          and "fix durability (closed first pass):      100.0%" in d_closed
          and "fix durability (closed first pass):      0.0%" in d_closed1)
    print(f"{'PASS' if ok else 'FAIL'}: fix durability excludes superseded, reopened=fail, closed@0=success (F-0016)" + ("" if ok else f" -> {[d_mix, d_reop, d_closed, d_closed1]}"))
    failed += 0 if ok else 1

    # F-0017: metrics report total absorbed members of class findings
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(

        (audit / "findings" / "CF-0001-c.md").write_text(
            "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: closed\nmembers: F-9999\nattempts: 0\n---\n", encoding="utf-8")
        _, _, _, k_unlisted, d_unlisted = state_and_decision(proj, conf)

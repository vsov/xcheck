        st = rd("xcheck-status")
        if st and "mkdir audit/.lock" in st:
            problems.append("xcheck-status: acquires the writing lock (must stay read-only)")
        # whole-BLOCK canonical contracts: byte-for-byte, so a flipped control action inside a
        # sentence (not just a renamed keyword) diverges the block and is caught.
        for n, blocks in _CANON_BLOCKS.items():
            t = rd(n)
            if t is None:
                problems.append(f"{n}: MISSING"); continue
            for label, canon in blocks:
                if canon not in t:
                    problems.append(f"{n}: canonical {label} block altered (not byte-for-byte present)")
        return problems
    clean129 = _role_prompt_problems(_rp50_root / "skills")
    def _mut_skills(td, rel, old, new):
        mskills = Path(td) / "skills"
        _sh50.copytree(_rp50_root / "skills", mskills)
        f = mskills / rel
        f.write_text(f.read_text(encoding="utf-8").replace(old, new), encoding="utf-8")

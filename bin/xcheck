        (audit / "findings" / "F-0002-b.md").write_text("---\nid: F-0002\nstatus: superseded-by-class\n---\n", encoding="utf-8")
        (audit / "findings" / "CF-0001-c.md").write_text("---\nid: CF-0001\nstatus: accepted\nmembers: [F-0001, F-0002]\n---\n", encoding="utf-8")
        b = _io2.StringIO()

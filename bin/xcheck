            print(f"{'PASS' if ok else 'FAIL'}: non-canonical members {bogus} fails closed on decision + lint (F-0050, CF-0001 I-13)"
                  + ("" if ok else f" -> {k_b},lint_rc={lint_rc}"))
            failed += 0 if ok else 1

    # F-0008: courier reports failure instead of a false success
    _saved_dirty = globals()["dirty_paths"]
    _orig_run = _sp.run
    globals()["dirty_paths"] = lambda project: {"audit/findings/F-0001-a.md"}
    _mode = {"fail": None}

    class _R:
        def __init__(self, rc, stdout=b""):
            self.returncode = rc
            self.stderr = ""
            self.stdout = stdout

    def _fake_git(cmd, **k):
        if cmd[:2] == ["git", "ls-files"]:
            return _R(0, b"audit/findings/F-0001-a.md\0")  # the dirt path is tracked -> addable
        if cmd[:2] == ["git", "add"]:
            return _R(1 if _mode["fail"] == "add" else 0)
        if cmd[:2] == ["git", "commit"]:
            return _R(1 if _mode["fail"] == "commit" else 0)
        return _R(0)

    _sp.run = _fake_git
    try:
        for fail, expect_ok, needle in [("add", False, "git add FAILED"),
                                        ("commit", False, "git commit FAILED"),
                                        (None, True, "committed the session")]:
            _mode["fail"] = fail
            bb = _io2.StringIO()
            with _cl2.redirect_stdout(bb):
                res = courier_commit(Path("/x"), "Remediator", "finding F-0001", set(), None)
            out = bb.getvalue()
            ok = res == expect_ok and needle in out and (expect_ok or "committed the session" not in out)
            print(f"{'PASS' if ok else 'FAIL'}: courier {fail or 'success'} -> {'commit' if expect_ok else 'failure reported'} (F-0008)" + ("" if ok else f" -> {res},{out[:80]}"))
            failed += 0 if ok else 1
    finally:
        _sp.run = _orig_run
        globals()["dirty_paths"] = _saved_dirty

    # F-0110: with push_after_commit ON, a failed `git push` is a courier FAILURE —
    # courier_commit returns False so run_session/loop stop instead of advancing as if
    # the opted-in remote handoff succeeded. add/commit succeed; only push fails. The
    # controls: a successful push returns True, and push OFF never invokes `git push`.
    _saved_dirty2 = globals()["dirty_paths"]
    _orig_run_p = _sp.run
    globals()["dirty_paths"] = lambda project: {"audit/findings/F-0001-a.md"}
    _push_called = {"hit": False}

    def _fake_git_push(cmd, **k):
        if cmd[:2] == ["git", "ls-files"]:
            return _R(0, b"audit/findings/F-0001-a.md\0")  # the dirt path is tracked -> addable
        if cmd[:2] == ["git", "push"]:
            _push_called["hit"] = True
            r = _R(1 if _push_mode["fail"] else 0)
            r.stderr = "remote rejected"
            return r
        return _R(0)

    _push_mode = {"fail": True}
    _sp.run = _fake_git_push
    try:
        bb = _io2.StringIO()
        with _cl2.redirect_stdout(bb):
            res_fail = courier_commit(Path("/x"), "Auditor", "c", set(), {"push_after_commit": "on"})
        out_fail = bb.getvalue()
        _push_mode["fail"] = False
        with _cl2.redirect_stdout(_io2.StringIO()):
            res_ok = courier_commit(Path("/x"), "Auditor", "c", set(), {"push_after_commit": "on"})
        _push_called["hit"] = False
        with _cl2.redirect_stdout(_io2.StringIO()):
            res_off = courier_commit(Path("/x"), "Auditor", "c", set(), {"push_after_commit": "off"})
        ok = (res_fail is False and "git push FAILED" in out_fail
              and res_ok is True and res_off is True and _push_called["hit"] is False)
        print(f"{'PASS' if ok else 'FAIL'}: opt-in push failure fails courier; success/off do not (F-0110)"
              + ("" if ok else f" -> fail={res_fail} ok={res_ok} off={res_off} push_called={_push_called['hit']}"))
        failed += 0 if ok else 1
    finally:
        _sp.run = _orig_run_p
        globals()["dirty_paths"] = _saved_dirty2

    # F-0009: run_session serializes subprocess + courier inside the lock
    events = []

    class _FakeLock:
        def __init__(self, audit, role):
            self.role = role

        def acquire(self):
            events.append("acquire")

        def release(self):
            events.append("release")

        def relabel(self, role):
            self.role = role

    def _fake_courier(project, role, charter, pre, conf=None, pre_head=None):
        events.append("courier")
        return True

    def _fake_sess(cmd, **k):
        # Let git probes (the F-0120 HEAD-baseline snapshot, dirty_paths) run for real —
        # proj is not a repo, so they no-op — and count ONLY the launched role session, so
        # this test still asserts the acquire/session/courier/release ORDER, not git calls.
        if cmd and cmd[0] == "git":
            return _orig_run2(cmd, **k)
        events.append("subprocess")
        return _R(0)

    _saved = {n: globals()[n] for n in ("Lock", "courier_commit", "dirty_paths")}
    _orig_run2 = _sp.run
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        (proj / "audit").mkdir()
        conf = {"remediator_cmd": "true {prompt}", "session_note": ""}
        globals()["Lock"] = _FakeLock
        globals()["courier_commit"] = _fake_courier
        globals()["dirty_paths"] = lambda p: set()
        _sp.run = _fake_sess
        try:
            events.clear()
            run_session(proj, conf, "Remediator", "finding F-0001", dry_run=False, lock=None)
            ok = events == ["acquire", "subprocess", "courier", "release"]
            print(f"{'PASS' if ok else 'FAIL'}: own-lock session runs courier before release (F-0009)" + ("" if ok else f" -> {events}"))
            failed += 0 if ok else 1
            events.clear()
            run_session(proj, conf, "Remediator", "finding F-0001", dry_run=False, lock=_FakeLock(proj / "audit", "orchestrator"))
            ok = events == ["subprocess", "courier"]
            print(f"{'PASS' if ok else 'FAIL'}: caller-held lock: session does not re-lock (F-0009)" + ("" if ok else f" -> {events}"))
            failed += 0 if ok else 1
        finally:
            _sp.run = _orig_run2
            for _n, _v in _saved.items():
                globals()[_n] = _v

    # F-0114: the terminal-triage sync in cmd_next mutates canonical finding files;
    # when the sync itself WRITES a file and its courier commit fails, the cycle must
    # STOP (stop-error), never certify `done` or launch a role over that uncommitted
    # write (case 1). The human ruling (2026-07-28) is declaration-over-inference: the
    # sync declares ONLY a path it wrote this call, so a file that is terminal on disk
    # but not in HEAD — indistinguishable from operator work — is never guessed as the
    # sync's own and never swept (cases 2, 3, 5). Drive cmd_next end-to-end against a
    # STATEFUL, CONTENT-BASED git fake: `git show HEAD:<f>` returns the last committed
    # TEXT; dirt = the on-disk text differs from it; a successful commit snapshots the
    # text (dirt clears), a failing commit leaves it. Modelling HEAD by content (not
    # just the status line) is what lets cases 2 and 5 reproduce the reopen's collateral
    # defect — operator scratch on a terminal-but-uncommitted finding, which the old
    # subtraction/retry-declaration heuristic swept into a courier commit.
    class _FakeLock114:
        def __init__(self, audit, role):
            self.role = role

        def acquire(self):
            pass

        def release(self):
            pass

        def relabel(self, role):
            self.role = role

    _saved114 = {n: globals()[n] for n in ("Lock", "dirty_paths")}
    _orig_run114 = _sp.run
    _REL114 = "audit/findings/F-0001-a.md"

    def _body114(status, scratch=False):
        # a well-formed finding file; `scratch` models an uncommitted operator body
        # edit that leaves the status line untouched.
        tail = "OPERATOR_SCRATCH\n" if scratch else ""
        return (f"---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\n"
                f"dimension: invariants\nunit: B01\nstatus: {status}\nattempts: 0\n---\n{tail}")

    def _run_cmd_next_114(commit_fail, initial_status, committed_status, scratch=False):
        # initial_status = the finding file's on-disk status at entry; committed_status
        # = the status of its last successful commit (None = never committed). initial !=
        # committed models a prior failed sync (leftover uncommitted dirt) — the reopen's
        # retry state. scratch models operator body dirt with the status line unchanged.
        with tempfile.TemporaryDirectory() as td:
            proj = Path(td)
            audit = proj / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "XCHECK.md").write_text("x", encoding="utf-8")
            complete_audit(audit, queue="## 4. Pass queue\n- [x] P-01 — done\n")
            (audit / "LEDGER.md").write_text(_ledger(
                "| F-0001 | a | major | rejected | human | 2026-07-21 |\n"), encoding="utf-8")
            fpath = audit / "findings" / "F-0001-a.md"
            fpath.write_text(_body114(initial_status, scratch), encoding="utf-8")
            (audit / "orchestrator.conf").write_text("batch_size=8\ntriage_batch_cap=0\nsession_note=\n", encoding="utf-8")
            state = {"committed_text": _body114(committed_status) if committed_status else None,
                     "commits": 0}

            def _fake_dirty(p):
                return {_REL114} if fpath.read_text(encoding="utf-8") != state["committed_text"] else set()

            def _fake_git114(cmd, **k):
                if cmd[:2] == ["git", "ls-files"]:
                    return _R(0, (_REL114 + "\0").encode("utf-8"))
                if cmd[:2] == ["git", "show"]:  # HEAD:<rel> -> committed text (F-0114 provenance)
                    if state["committed_text"] is None:
                        return _R(1)
                    return _R(0, state["committed_text"])
                if cmd[:2] == ["git", "commit"]:
                    if commit_fail:
                        return _R(1)
                    state["committed_text"] = fpath.read_text(encoding="utf-8")  # snapshot -> dirt clears
                    state["commits"] += 1
                    return _R(0)
                return _R(0)

            globals()["Lock"] = _FakeLock114
            globals()["dirty_paths"] = _fake_dirty
            _sp.run = _fake_git114
            try:
                _b = io.StringIO()
                with contextlib.redirect_stdout(_b):
                    kind = cmd_next(proj, load_conf(audit), dry_run=False)
                out = _b.getvalue()
                final_text = fpath.read_text(encoding="utf-8")
            finally:
                globals()["Lock"] = _saved114["Lock"]
                globals()["dirty_paths"] = _saved114["dirty_paths"]
                _sp.run = _orig_run114
        return kind, out, state["commits"], final_text

    # 1. First run, commit fails: sync mutates reported->rejected, commit fails ->
    #    stop-error, no done/role, nothing committed.
    k, o, c, _ = _run_cmd_next_114(True, "reported", "reported")
    ok = k == "stop-error" and "could not durably commit" in o and "done" not in o and c == 0
    print(f"{'PASS' if ok else 'FAIL'}: failed sync commit stops cmd_next — no done, no role (F-0114)"
          + ("" if ok else f" -> kind={k} commits={c} out={o[:100]}"))
    failed += 0 if ok else 1

    # 2. Provenance poison (the exact re-take reopen): the finding is terminal on disk
    #    (`rejected`) but HEAD still says `reported`, and the operator has body scratch on
    #    it — the state you get when the operator hand-applied the pending decision AND
    #    edited the body before this `next`. It is INDISTINGUISHABLE from a leftover of a
    #    prior failed sync, so the human ruling is declaration-over-inference: the sync did
    #    NOT write this file this call, so it declares nothing, and the courier must sweep
    #    nothing. Expect: no commit, scratch left untouched, decision reads the canonical
    #    file. The old retry-declaration guessed "leftover", declared it, and the courier
    #    committed the operator scratch — reinstating that guess turns c==1 / scratch gone,
    #    red.
    k, o, c, final = _run_cmd_next_114(False, "rejected", "reported", scratch=True)
    ok = k == "done" and c == 0 and "OPERATOR_SCRATCH" in final
    print(f"{'PASS' if ok else 'FAIL'}: terminal-on-disk-but-not-in-HEAD finding with operator scratch is never swept — sync declares only what it wrote (F-0114 re-take reopen, human ruling)"
          + ("" if ok else f" -> kind={k} commits={c} scratch_kept={'OPERATOR_SCRATCH' in final}"))
    failed += 0 if ok else 1

    # 3. The same ambiguous state WITHOUT scratch: still not the sync's to commit. The
    #    cost the ruling accepts of never guessing ownership — a genuinely-leftover
    #    uncommitted sync is treated as pre-existing dirt, not auto-retried (the first
    #    failed commit already stop-errored and warned the human). The canonical file on
    #    disk carries the terminal status, so the decision is correct even while HEAD lags;
    #    nothing is committed under someone else's name.
    k, o, c, _ = _run_cmd_next_114(False, "rejected", "reported")
    ok = k == "done" and c == 0
    print(f"{'PASS' if ok else 'FAIL'}: an ambiguous terminal-but-uncommitted finding is left as pre-existing dirt, never guessed as the sync's own (F-0114 human ruling)"
          + ("" if ok else f" -> kind={k} commits={c}"))
    failed += 0 if ok else 1

    # 4. Control — first run, commit succeeds: sync committed, decision continues.
    k, o, c, _ = _run_cmd_next_114(False, "reported", "reported")
    ok = k == "done" and c == 1
    print(f"{'PASS' if ok else 'FAIL'}: successful sync commit lets the decision continue to done (F-0114)"
          + ("" if ok else f" -> kind={k} commits={c}"))
    failed += 0 if ok else 1

    # 5. Collateral (human ruling): the terminal decision is ALREADY committed in HEAD
    #    (committed==decision==rejected) and the operator then edited the finding BODY
    #    without touching the status. The sync must NOT claim this file — HEAD proves the
    #    decision durable — so nothing is committed and the operator's scratch is left in
    #    the worktree, untouched (courier contract: pre-existing operator dirt is never
    #    swept in). The reopen bug did the opposite: it inferred ownership by subtraction,
    #    committed the scratch, and cleaned the worktree. Regressing to that turns c==1 /
    #    the scratch committed, red.
    k, o, c, final = _run_cmd_next_114(False, "rejected", "rejected", scratch=True)
    ok = k == "done" and c == 0 and "OPERATOR_SCRATCH" in final
    print(f"{'PASS' if ok else 'FAIL'}: operator body dirt on an already-committed-terminal finding is never swept in (F-0114 collateral, human ruling)"
          + ("" if ok else f" -> kind={k} commits={c} scratch_kept={'OPERATOR_SCRATCH' in final}"))
    failed += 0 if ok else 1

    # 6. Mixed-ownership path (the re-take #2 reopen, human ruling 2026-07-28 — refuse,
    #    do not split). The file is still `reported` on disk BUT the operator already
    #    edited its body before this `next` (HEAD = reported, no scratch; on-disk =
    #    reported + scratch — so the path is dirty BEFORE the session). The sync must NOT
    #    write the terminal status onto it: doing so would mix its own write with the
    #    operator's pre-session edit in one whole-file commit. So it leaves the file
    #    entirely untouched — status STAYS `reported`, scratch intact — and hands the path
    #    back as mixed. Expect stop-error, the path NAMED in the output, nothing committed
    #    (c==0), and the file left in the worktree with its ORIGINAL `reported` status
    #    (`status: reported`, not the terminal decision) plus the operator scratch. Because
    #    it stays `reported`, a later `next` still refuses done (stop-triage-unsynced) —
    #    case 8 covers that persistence. Reinstating a write-then-commit turns
    #    c==1 / scratch committed / done, red.
    k, o, c, final = _run_cmd_next_114(False, "reported", "reported", scratch=True)
    ok = (k == "stop-error" and c == 0 and "mixed-ownership" in o and _REL114 in o
          and "OPERATOR_SCRATCH" in final and "status: reported" in final)
    print(f"{'PASS' if ok else 'FAIL'}: a mixed-ownership finding (pre-session operator body dirt) is left entirely untouched — never written, never committed, named and handed to the human (F-0114 re-take, human ruling)"
          + ("" if ok else f" -> kind={k} commits={c} named={_REL114 in o} scratch_kept={'OPERATOR_SCRATCH' in final} status_untouched={'status: reported' in final}"))
    failed += 0 if ok else 1

    # 7. Control (charter re-take pt 3): a file touched ONLY by the session — clean before
    #    the sync, rewritten reported->rejected — still commits as before and continues to
    #    the decision. Distinguishes the mixed-ownership refusal (case 6) from a blanket
    #    "never commit a synced path" regression.
    k, o, c, _ = _run_cmd_next_114(False, "reported", "reported")
    ok = k == "done" and c == 1 and "mixed-ownership" not in o
    print(f"{'PASS' if ok else 'FAIL'}: a session-only synced finding (no pre-session dirt) still commits and continues (F-0114 re-take #2 control)"
          + ("" if ok else f" -> kind={k} commits={c} out={o[:100]}"))
    failed += 0 if ok else 1

    # 8. Multi-finding batch — the re-take #3 reopen (human ruling 2026-07-28): report on
    #    every exit, and no done over an open handoff. ONE sync batch mixes a PURE path
    #    (clean before the session) and a MIXED path (operator body scratch before the
    #    session, still `reported`), and the courier commit of the PURE path FAILS. The
    #    mixed path must be NAMED on that failing exit too (finally), and a subsequent
    #    `next` must NOT report done while the handoff is unresolved. A STATEFUL, content-
    #    based two-file git fake: `git show HEAD:<rel>` -> committed text per path; dirt =
    #    on-disk text != committed; a scoped commit snapshots only its pathspec.
    def _run_batch_114(commit_fail_first, twice):
        pure_rel = "audit/findings/F-0001-pure.md"
        mixed_rel = "audit/findings/F-0002-mixed.md"

        def _b(fid, status, scratch):
            tail = "OPERATOR_SCRATCH\n" if scratch else ""
            return (f"---\nid: {fid}\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\n"
                    f"dimension: invariants\nunit: B01\nstatus: {status}\nattempts: 0\n---\n{tail}")

        with tempfile.TemporaryDirectory() as td:
            proj = Path(td)
            audit = proj / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "XCHECK.md").write_text("x", encoding="utf-8")
            complete_audit(audit, queue="## 4. Pass queue\n- [x] P-01 — done\n")
            (audit / "LEDGER.md").write_text(_ledger(
                "| F-0001 | a | major | rejected | human | 2026-07-21 |\n"
                "| F-0002 | a | major | rejected | human | 2026-07-21 |\n"), encoding="utf-8")
            (audit / "orchestrator.conf").write_text("batch_size=8\ntriage_batch_cap=0\nsession_note=\n", encoding="utf-8")
            # pure: clean before the session (on-disk == committed). mixed: operator body
            # scratch before the session (on-disk != committed), still `reported`.
            (audit / "findings" / "F-0001-pure.md").write_text(_b("F-0001", "reported", False), encoding="utf-8")
            (audit / "findings" / "F-0002-mixed.md").write_text(_b("F-0002", "reported", True), encoding="utf-8")
            committed = {pure_rel: _b("F-0001", "reported", False),
                         mixed_rel: _b("F-0002", "reported", False)}  # HEAD: both reported, no scratch
            state = {"fail": commit_fail_first, "commits": 0}
            rels = {pure_rel, mixed_rel}

            def _fake_dirty(p):
                return {rel for rel in rels
                        if (proj / rel).read_text(encoding="utf-8") != committed.get(rel)}

            def _fake_git(cmd, **k):
                if cmd[:2] == ["git", "ls-files"]:
                    return _R(0, ("\0".join(sorted(rels)) + "\0").encode("utf-8"))
                if cmd[:2] == ["git", "show"]:
                    rel = cmd[2].split(":", 1)[1]
                    txt = committed.get(rel)
                    return _R(1) if txt is None else _R(0, txt)
                if cmd[:2] == ["git", "commit"]:
                    if state["fail"]:
                        return _R(1)
                    idx = cmd.index("--") if "--" in cmd else None
                    for rel in (cmd[idx + 1:] if idx is not None else []):
                        committed[rel] = (proj / rel).read_text(encoding="utf-8")
                    state["commits"] += 1
                    return _R(0)
                return _R(0)

            globals()["Lock"] = _FakeLock114
            globals()["dirty_paths"] = _fake_dirty
            _sp.run = _fake_git
            try:
                def _one():
                    b = io.StringIO()
                    with contextlib.redirect_stdout(b):
                        kk = cmd_next(proj, load_conf(audit), dry_run=False)
                    return kk, b.getvalue()
                out = {}
                out["k1"], out["o1"] = _one()
                if twice:
                    state["fail"] = False   # lift the artificial failure; sync now declares nothing
                    out["k2"], out["o2"] = _one()
                out["commits"] = state["commits"]
            finally:
                globals()["Lock"] = _saved114["Lock"]
                globals()["dirty_paths"] = _saved114["dirty_paths"]
                _sp.run = _orig_run114
        return out

    _MIXED_REL = "audit/findings/F-0002-mixed.md"
    r = _run_batch_114(commit_fail_first=True, twice=True)
    ok = (r["k1"] == "stop-error" and "mixed-ownership" in r["o1"] and _MIXED_REL in r["o1"]
          and r["k2"] == "stop-error" and _MIXED_REL in r["o2"] and "audit complete" not in r["o2"])
    print(f"{'PASS' if ok else 'FAIL'}: a failing pure-path commit still NAMES the mixed path (finally), and a later next refuses done over the open handoff (F-0114 re-take #3, human ruling)"
          + ("" if ok else f" -> k1={r['k1']} named1={_MIXED_REL in r['o1']} mixed1={'mixed-ownership' in r['o1']} k2={r['k2']} named2={_MIXED_REL in r.get('o2','')} done2={'audit complete' in r.get('o2','')}"))
    failed += 0 if ok else 1

    # mechanically enumerate courier_commit callsites: every PRODUCTION caller must
    # CAPTURE the committed-flag; a bare `courier_commit(...)` statement drops it and
    # advances the lifecycle over an uncommitted handoff (the F-0114 bug).
    _cc_offenders = [ln.strip() for ln in Path(__file__).read_text(encoding="utf-8").splitlines()
                     if ln.strip().startswith("courier_commit(")]
    ok = not _cc_offenders
    print(f"{'PASS' if ok else 'FAIL'}: no courier_commit callsite drops the committed-flag (F-0114)"
          + ("" if ok else f" -> {_cc_offenders}"))
    failed += 0 if ok else 1

    # F-0009: NO orchestrator write (incl. the log dir) escapes the lock — an
    # observer inside acquire() must not yet see audit/orchestrator-logs.
    _saved2 = {n: globals()[n] for n in ("Lock", "courier_commit", "dirty_paths")}
    _orig_run3 = _sp.run
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        (proj / "audit").mkdir()
        conf = {"remediator_cmd": "true {prompt}", "session_note": ""}
        obs = {"logs_at_acquire": None}

        class _ObsLock:
            def __init__(self, audit, role):
                self.audit = Path(audit)
                self.role = role

            def acquire(self):
                obs["logs_at_acquire"] = (self.audit / "orchestrator-logs").exists()

            def release(self):
                pass

            def relabel(self, role):
                self.role = role

        globals()["Lock"] = _ObsLock
        globals()["courier_commit"] = lambda *a, **k: True
        globals()["dirty_paths"] = lambda p: set()
        _sp.run = lambda cmd, **k: _R(0)
        try:
            run_session(proj, conf, "Remediator", "finding F-0001", dry_run=False, lock=None)
            ok = obs["logs_at_acquire"] is False
            print(f"{'PASS' if ok else 'FAIL'}: no orchestrator write precedes lock acquire (F-0009)" + ("" if ok else f" -> logs_at_acquire={obs['logs_at_acquire']}"))
            failed += 0 if ok else 1
        finally:
            _sp.run = _orig_run3
            for _n, _v in _saved2.items():
                globals()[_n] = _v

    # F-0108: an unrunnable agent command (missing executable in <role>_cmd) becomes
    # the addressed session-error stop, NOT a raw traceback: subprocess.run raises
    # before returning a code, run_session catches it, names the command, returns
    # non-zero, and the (real) lock is still released. Uses the REAL Lock/subprocess
    # so the spawn genuinely fails.
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        (proj / "audit").mkdir()
        conf_missing = {"remediator_cmd": "__xcheck_no_such_agent__ {prompt}", "session_note": ""}
        b = _io2.StringIO()
        raised = False
        rc_spawn = None
        try:
            with _cl2.redirect_stdout(b):
                rc_spawn = run_session(proj, conf_missing, "Remediator", "finding F-0001", dry_run=False)
        except OSError:
            raised = True
        out = b.getvalue()
        lock_gone = not (proj / "audit" / ".lock").exists()
        ok = (not raised and rc_spawn == 1 and lock_gone
              and "__xcheck_no_such_agent__" in out and "Traceback" not in out)
        print(f"{'PASS' if ok else 'FAIL'}: unrunnable agent command -> addressed stop, lock released (F-0108)"
              + ("" if ok else f" -> raised={raised} rc={rc_spawn} lock_gone={lock_gone} out={out[:120]!r}"))
        failed += 0 if ok else 1

    # F-0108 reopen: the session error must reach the CLI EXIT CODE, not only stdout.
    # Drive the WHOLE command through main(): an accepted finding routes to a
    # Remediator session whose agent command is unrunnable -> cmd_next returns
    # "stop-error" -> main must return a NON-ZERO exit (README §8 session-error
    # contract), not discard it and fall through to `return 0`.
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        audit = proj / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "XCHECK.md").write_text("x", encoding="utf-8")
        # complete plan, but an UNCHECKED queue (no checked pass -> no coverage gate);
        # the accepted finding routes to run-remediator ahead of the audit branch.
        complete_audit(audit, queue="## 4. Pass queue\n- [ ] P-01 — spec × B01: c\n", coverage_pass=None)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\n"
            "dimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "orchestrator.conf").write_text(
            "remediator_cmd=__xcheck_no_such_agent__ {prompt}\n", encoding="utf-8")
        b = _io2.StringIO()
        rc_cli = None
        with _cl2.redirect_stdout(b):
            try:
                rc_cli = main(["xcheck", "--project", str(proj), "next"])
            except SystemExit as e:
                rc_cli = e.code
        out = b.getvalue()
        lock_gone = not (audit / ".lock").exists()
        ok = (rc_cli not in (0, None) and lock_gone
              and "__xcheck_no_such_agent__" in out and "Traceback" not in out)
        print(f"{'PASS' if ok else 'FAIL'}: session error propagates to a NON-ZERO `next` CLI exit (F-0108)"
              + ("" if ok else f" -> rc={rc_cli} lock_gone={lock_gone} out={out[-160:]!r}"))
        failed += 0 if ok else 1

    # F-0109: `--porcelain -z` reads non-ASCII names verbatim (no C-quoting), carries
    # BOTH sides of a rename (so the courier stages the whole rename, not just the new
    # name), and does not mis-split a path that literally contains ` -> `. Real temp
    # git repo: ASCII/whitespace/Unicode untracked + two renames (one dest holds
    # ` -> `) + a pre-existing dirty file that must STAY OUT of the commit.
    # The session dirt lives under audit/ so the parsing/whole-rename guarantee is tested
    # WITHOUT the F-0120 scratch guard (new untracked TOP-LEVEL paths outside audit/) —
    # dirty_paths parsing is location-independent, and a Unicode/renamed finding file is
    # exactly the audit/ path this must handle. preexisting.md stays at the ROOT.
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        (proj / "audit").mkdir()

        def _git(*a):
            return _sp.run(["git", "-C", str(proj)] + list(a), capture_output=True, text=True)

        _git("init", "-q")
        _git("config", "user.email", "t@t")
        _git("config", "user.name", "t")
        _git("config", "commit.gpgsign", "false")
        # tracked files to rename during the "session"
        (proj / "audit" / "old.md").write_text("o", encoding="utf-8")
        (proj / "audit" / "arrow.md").write_text("r", encoding="utf-8")
        _git("add", "-A")
        _git("commit", "-q", "-m", "seed")
        # a pre-existing dirty file that predates the session -> must be left untouched
        (proj / "preexisting.md").write_text("p", encoding="utf-8")
        pre = dirty_paths(proj)
        # the session's own dirt: untracked names + two renames (a dest holds ` -> `)
        (proj / "audit" / "ascii.md").write_text("a", encoding="utf-8")
        (proj / "audit" / "with space.md").write_text("b", encoding="utf-8")
        (proj / "audit" / "ünïcodé.md").write_text("c", encoding="utf-8")
        _git("mv", "audit/old.md", "audit/新しい ファイル.md")
        _git("mv", "audit/arrow.md", "audit/renamed -> nouveau.md")
        # F-0109 re-take (Verifier poison, human ruling 2026-07-28): the session's own new
        # BROKEN symlink. git reports it dirty, but its target is missing, so `Path.exists()`
        # follows the dangling link and returns False — the staging filter must test the
        # entry itself (`os.path.lexists`) or the commit fatals on the "unknown" pathspec.
        os.symlink("missing-target", proj / "audit" / "lien cassé")
        post = dirty_paths(proj)
        sess = session_dirt(pre, post)
        # both rename SIDES are session dirt (origin deletion + dest addition), the
        # arrow-containing dest parsed intact, the broken symlink is carried, and
        # preexisting.md is NOT swept in.
        want_sess = {"audit/ascii.md", "audit/with space.md", "audit/ünïcodé.md",
                     "audit/old.md", "audit/新しい ファイル.md", "audit/arrow.md",
                     "audit/renamed -> nouveau.md", "audit/lien cassé"}
        paths_ok = want_sess <= sess and "preexisting.md" not in sess
        ok_commit = courier_commit(proj, "Auditor", "unicode+rename dirt", pre, None)
        after = dirty_paths(proj)
        # the whole session is committed (nothing of it left dirty); preexisting stays.
        clean = ok_commit and after == {"preexisting.md"}
        ok = paths_ok and clean
        print(f"{'PASS' if ok else 'FAIL'}: dirty_paths -z stages Unicode + full renames, keeps preexisting out (F-0109)"
              + ("" if ok else f" -> sess={sorted(sess)} ok_commit={ok_commit} after={sorted(after) if after else after}"))
        failed += 0 if ok else 1

    # F-0009 (sanctioned re-take): the WHOLE next-transaction is under the lock,
    # incl. the default-conf write. Drive a LIVE foreign lock through main()/
    # cmd_next (not just run_session): an aborting `next` must write NOTHING.
    # This is the regression the run_session-only checks above could not catch —
    # the conf write escaped in main(), before cmd_next acquired the lock.
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        audit = proj / "audit"
        audit.mkdir()
        (audit / "XCHECK.md").write_text("x", encoding="utf-8")
        # a live foreign lock: this process's own pid is alive
        _put_lock(audit, {"pid": os.getpid(), "role": "orchestrator", "started": "x", "host": "x"})
        conf_path = audit / "orchestrator.conf"
        before = conf_path.exists()
        aborted, msg = False, ""
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            try:
                main(["xcheck", "--project", str(proj), "next"])
            except SystemExit as e:
                aborted, msg = True, str(e)
        after = conf_path.exists()
        ok = aborted and before is False and after is False and "LIVE" in msg
        print(f"{'PASS' if ok else 'FAIL'}: live foreign lock aborts `next` via main with NO pre-lock conf write (F-0009)"
              + ("" if ok else f" -> aborted={aborted} before={before} after={after}"))
        failed += 0 if ok else 1

    # F-0010: os.kill EPERM (PermissionError) means the process is ALIVE, not
    # dead — only ESRCH (ProcessLookupError) is dead.
    _orig_kill = os.kill
    try:
        os.kill = lambda pid, sig: (_ for _ in ()).throw(PermissionError())
        alive_eperm = pid_alive(4242) is True
        os.kill = lambda pid, sig: (_ for _ in ()).throw(ProcessLookupError())
        dead_esrch = pid_alive(4242) is False
    finally:
        os.kill = _orig_kill
    ok = alive_eperm and dead_esrch
    print(f"{'PASS' if ok else 'FAIL'}: pid_alive treats EPERM as alive, ESRCH as dead (F-0010)" + ("" if ok else f" -> eperm={alive_eperm} esrch={dead_esrch}"))
    failed += 0 if ok else 1
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        (proj / "audit").mkdir()
        _put_lock(proj / "audit", {"pid": 4242, "role": "orchestrator", "started": "x", "host": "x"})
        os.kill = lambda pid, sig: (_ for _ in ()).throw(PermissionError())
        try:
            refused = False
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                try:
                    cmd_unlock(proj, False)
                except SystemExit:
                    refused = True
            still = (proj / "audit" / ".lock").exists()
        finally:
            os.kill = _orig_kill
        ok = refused and still
        print(f"{'PASS' if ok else 'FAIL'}: unlock refuses an EPERM-live lock without --force (F-0010)" + ("" if ok else f" -> refused={refused} still={still}"))
        failed += 0 if ok else 1

    # F-0011: a checked pass with no complete coverage report blocks 'done'
    with tempfile.TemporaryDirectory() as td:
        proj = Path(td)
        audit = proj / "audit"
        audit.mkdir()
        (audit / "XCHECK.md").write_text("x", encoding="utf-8")
        # F-0077: complete plan (norm-backed dimension + unit map) so the queue's
        # lone checked pass reaches the coverage gate under test, not the Planner.
        # coverage_pass=None: this fixture writes P-03's report itself, below.
        complete_audit(audit, queue="## 4. Pass queue\n- [x] P-03 — done\n", coverage_pass=None)
        (audit / "LEDGER.md").write_text(
            "| id | title | severity | status | next | updated |\n|---|---|---|---|---|---|\n", encoding="utf-8")
        conf = {"batch_size": "8", "triage_batch_cap": "0", "session_note": ""}
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_noreport = cmd_next(proj, conf, dry_run=False)
        (audit / "passes").mkdir()
        pf = audit / "passes" / "P-03-x.md"
        pf.write_text("## Coverage\n**COVERED:** a\n**NOT COVERED:** b\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_complete = cmd_next(proj, conf, dry_run=False)
        pf.write_text("## Coverage\njust prose, no markers\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_incomplete = cmd_next(proj, conf, dry_run=False)
        # adversarial (Verifier F-0011 reopen): the bare uppercase words in prose
        # must NOT satisfy the gate — a marker is line-anchored, not a mention.
        pf.write_text(
            "This sentence merely mentions COVERED and NOT COVERED without reporting scope.\n",
            encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_prose = cmd_next(proj, conf, dry_run=False)
        # each real Auditor marker style still passes (### / bare COVERED:)
        pf.write_text("### COVERED\na\n### NOT COVERED\nb\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_hdr = cmd_next(proj, conf, dry_run=False)
        pf.write_text("## Coverage\nCOVERED: a\nNOT COVERED: b\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            k_bare = cmd_next(proj, conf, dry_run=False)
        ok = (k_noreport == "stop-coverage-missing" and k_complete == "done"
              and k_incomplete == "stop-coverage-missing" and k_prose == "stop-coverage-missing"
              and k_hdr == "done" and k_bare == "done")
        print(f"{'PASS' if ok else 'FAIL'}: coverage-report gate blocks 'done' on a checked pass w/o report (F-0011)" + ("" if ok else f" -> {k_noreport},{k_complete},{k_incomplete},{k_prose},{k_hdr},{k_bare}"))
        failed += 0 if ok else 1
        pf.unlink()
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            cmd_metrics(proj)
        ok = "passes without coverage report: 1" in b.getvalue()
        print(f"{'PASS' if ok else 'FAIL'}: metrics reports passes without coverage report (F-0011)" + ("" if ok else f" -> {b.getvalue()[:120]}"))
        failed += 0 if ok else 1

    # F-0111 (human ruling 2026-07-28, second ruling): a coverage marker is non-empty
    # only when its body holds a DECLARED CONTENT FORM — a list item or a prose line
    # not opening with `[`/`<`/`#` and not a ref-def continuation. Content is decided
    # POSITIVELY; invisibility is no longer enumerated. Every prior-round invisible
    # placeholder still reads as a gap because it is not the declared form, and the
    # newest poison — a multi-line reference definition with the title on the next
    # line — reads as a gap for the same reason. Drives the real passes_without_coverage.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td)
        (audit / "passes").mkdir(parents=True)
        (audit / "AUDIT.md").write_text("## 4. Pass queue\n- [x] P-01 — x\n", encoding="utf-8")
        pf = audit / "passes" / "P-01-x.md"
        for label, body, want_bad in [
            # HTML comments render to nothing and may span lines — blanked first, so an
            # empty body remains, which is not the declared content form -> gap.
            ("single-line HTML comment",
             "## Coverage\nCOVERED:\n<!-- TODO -->\nNOT COVERED:\n<!-- TODO -->\n", True),
            ("multi-line HTML comment",
             "COVERED:\n<!--\nTODO fill in\n-->\nNOT COVERED:\n<!--\nlater\n-->\n", True),
            # a link-reference definition opens with `[` — not the declared prose form -> gap.
            ("link-reference-definition placeholder",
             "COVERED:\n[covered-todo]: # (TODO)\nNOT COVERED:\n[not-covered-todo]: # (TODO)\n", True),
            ("colon-no-space ref-definition placeholder",
             "COVERED:\n[c]:/todo\nNOT COVERED:\n[n]:/todo\n", True),
            # under the declared-form ruling a line OPENING with `[` is not content, even
            # when it would render as a visible paragraph — a header is a fixed form and a
            # coverage line starting with `[` is not it. This is the accepted restriction,
            # locked so a relapse to 'any visible-ish line passes' cannot slip back in.
            ("bracket-opened line is not the declared form",
             "## Coverage\nCOVERED:\n[c]: audited B01\n\nNOT COVERED:\n[n]: nothing deferred\n", True),
            # F-0111 latest reopen poison (human ruling 2026-07-28): a multi-line reference
            # definition carries its title on the FOLLOWING line; both lines render to
            # nothing. The opener starts with `[`, and the wrapped title line is a ref-def
            # continuation — neither is the declared content form -> gap.
            ("multi-line ref-def with wrapped title",
             "## Coverage\nCOVERED:\n[c]: /todo\n  \"covered title\"\nNOT COVERED:\n[n]: /todo\n  \"not-covered title\"\n", True),
            # F-0111 reopen (Verifier poison, 2026-07-28): a line that starts with `[`
            # but has no `]:` (`[context]`) opens NO reference definition, so the prose
            # line under it is real content, not a ref-def continuation. The guard used
            # to treat any bracket line as an opener and wrongly discard the visible
            # prose below it — reverting `prev_bracket` to `s.startswith("[")` flips this
            # back to a (false) gap.
            ("bracket-non-opener above prose is content",
             "## Coverage\nCOVERED:\n[context]\nunit B01 audited\nNOT COVERED:\n[context]\nnothing deferred\n", False),
            # F-0111 latest reopen poison (human ruling 2026-07-28, third ruling): the
            # list-item form admitted an EMPTY element — a lone `-` renders to an empty
            # <li> and reports nothing. A list item counts only with reportable text after
            # the marker; reverting to accepting a bare marker flips this back to (false) ok.
            ("empty list item is a gap",
             "## Coverage\nCOVERED:\n-\nNOT COVERED:\n-\n", True),
            # the same requirement on the prose branch: a line of only punctuation reports
            # nothing and is a silent gap, not content.
            ("punctuation-only line is a gap",
             "## Coverage\nCOVERED:\n...\nNOT COVERED:\n...\n", True),
            # declared forms PASS: a prose line and a list item are the content form.
            ("real prose content passes",
             "**COVERED:** unit B01 audited.\n**NOT COVERED:** nothing deferred.\n", False),
            ("list-item content passes",
             "COVERED:\n- unit B01 audited\nNOT COVERED:\n- nothing deferred\n", False),
        ]:
            pf.write_text(body, encoding="utf-8")
            bad = passes_without_coverage(audit)
            ok = ("P-01" in bad) == want_bad
            print(f"{'PASS' if ok else 'FAIL'}: coverage gate on {label} -> {'gap' if want_bad else 'ok'} (F-0111)"
                  + ("" if ok else f" -> bad={bad} (want_bad={want_bad})"))
            failed += 0 if ok else 1

    # F-0012: a rejected CF with an 'accepted' member is legal (§8 rule 4)
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"
            "| CF-0001 | c | major | rejected | — | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "findings" / "CF-0001-c.md").write_text(
            "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: c\nseverity: major\ndimension: invariants\nunit: B01\nstatus: rejected\nmembers: [F-0001]\nattempts: 0\n---\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            rc = cmd_lint(Path(td))
        ok = rc == 0 and "clean" in b.getvalue()
        print(f"{'PASS' if ok else 'FAIL'}: lint accepts rejected-CF member reverted to accepted (F-0012)" + ("" if ok else f" -> rc={rc} {b.getvalue()[:120]}"))
        failed += 0 if ok else 1

    # F-0012 (Verifier reopen): the PENDING pre-sync state is also legal — CF
    # rejected, member file still `superseded-by-class`, LEDGER already `accepted`
    # (§2 rule 3 member-reversion delta). lint must not flag the ledger/file gap.
    with tempfile.TemporaryDirectory() as td:
        audit = Path(td) / "audit"
        (audit / "findings").mkdir(parents=True)
        (audit / "LEDGER.md").write_text(_ledger(
            "| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"
            "| CF-0001 | c | major | rejected | — | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text(
            "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: superseded-by-class\nclass: CF-0001\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "findings" / "CF-0001-c.md").write_text(
            "---\nid: CF-0001\npass: P-01\nupdated: 2026-07-21\ntitle: c\nseverity: major\ndimension: invariants\nunit: B01\nstatus: rejected\nmembers: [F-0001]\nattempts: 0\n---\n", encoding="utf-8")
        b = _io2.StringIO()
        with _cl2.redirect_stdout(b):
            rc = cmd_lint(Path(td))
        ok = rc == 0 and "clean" in b.getvalue()
        print(f"{'PASS' if ok else 'FAIL'}: lint accepts pending superseded->accepted member reversion (F-0012)" + ("" if ok else f" -> rc={rc} {b.getvalue()[:160]}"))
        failed += 0 if ok else 1

    # F-0013: filename<->id mismatch and duplicate ids are caught; control is clean
    def _lint_out(setup):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            setup(audit)
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            return rc, b.getvalue()

    def _mismatch(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-9999-wrong.md").write_text("---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")

    def _dup(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text("---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")
        (audit / "findings" / "F-0001-b.md").write_text("---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")

    def _control(audit):
        (audit / "LEDGER.md").write_text(_ledger("| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"), encoding="utf-8")
        (audit / "findings" / "F-0001-a.md").write_text("---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n", encoding="utf-8")

    # adversarial (Verifier F-0013 reopen): a finding file with valid frontmatter
    # but NO `id` was counted-but-unchecked and passed as clean. It must be flagged.
    def _noid(audit):
        (audit / "LEDGER.md").write_text(_ledger(""), encoding="utf-8")
        (audit / "findings" / "F-0001-no-id.md").write_text("---\nstatus: accepted\n---\n", encoding="utf-8")

    rc1, o1 = _lint_out(_mismatch)
    rc2, o2 = _lint_out(_dup)
    rc3, o3 = _lint_out(_control)
    rc4, o4 = _lint_out(_noid)
    ok = (rc1 == 1 and "F-9999" in o1 and "!= frontmatter id" in o1
          and rc2 == 1 and "share this id" in o2
          and rc3 == 0 and "clean" in o3
          and rc4 == 1 and "no 'id'" in o4)
    print(f"{'PASS' if ok else 'FAIL'}: lint catches filename/id mismatch + duplicate id + missing id, control clean (F-0013)" + ("" if ok else f" -> {rc1}/{o1[:60]} | {rc2}/{o2[:60]} | {rc3} | {rc4}/{o4[:60]}"))
    failed += 0 if ok else 1

    # F-0014: `next` is a fixed vocabulary, not any string containing needs-human.
    # F-0102: membership is not enough — `next` must also name the OWNER of the
    # finding's status. _next_case parametrizes the status so both rules are
    # exercised together; a `fixed` row carries a well-formed `fixed-by` so the
    # F-0096 provenance gate is not what trips it.
    def _next_case(val, status="accepted", attempts="0"):
        with tempfile.TemporaryDirectory() as td:
            audit = Path(td) / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "LEDGER.md").write_text(_ledger(f"| F-0001 | a | major | {status} | {val} | 2026-07-21 |\n"), encoding="utf-8")
            extra = "\nfixed-by: 0123456789abcdef" if status == "fixed" else ""
            (audit / "findings" / "F-0001-a.md").write_text(f"---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: {status}{extra}\nattempts: {attempts}\n---\n", encoding="utf-8")
            b = _io2.StringIO()
            with _cl2.redirect_stdout(b):
                rc = cmd_lint(Path(td))
            return rc
    # membership (F-0014): garbage rejected on any status
    reject_vals = ["garbage needs-human garbage", "", "⚠ needs-human extra"]
    ok = all(_next_case(v) == 1 for v in reject_vals)
    # CF-0001 (I-5 + I-14, human ruling #3): the `⚠ needs-human` flag is legal ONLY on a
    # `reopened` finding that REACHED the reopen limit (§5/§63: attempts+1 >= reopen_limit),
    # NOT a blanket exception for any reopened row. With the default reopen_limit=2,
    # attempts:0 is a SINGLE reopen (below the limit — flag illegal, I-14), attempts:1 is
    # the SECOND reopen (at the limit — flag legal). The old code accepted the flag on any
    # `reopened` row (and earlier on `accepted`); a premature/misplaced flag passed lint AND
    # halted decide()'s whole cycle. Clean only on reopened AT the limit, rejected elsewhere.
    ok = ok and _next_case("⚠ needs-human", "reopened", "1") == 0 \
        and _next_case("human ⚠ needs-human", "reopened", "1") == 0 \
        and _next_case("⚠ needs-human", "reopened", "0") == 1 \
        and _next_case("⚠ needs-human", "accepted") == 1 \
        and _next_case("human ⚠ needs-human", "closed") == 1 \
        and _next_case("⚠ needs-human", "reported") == 1
    # plain owner token is clean on its owning status
    ok = ok and _next_case("Remediator", "accepted") == 0
    # F-0102: a membership-valid role on the WRONG status is rejected — Verifier on
    # a `reported` row owed human triage, Remediator on a Verifier-owned `fixed`
    # row, `human` on a terminal `closed` row (must be `—`).
    ok = ok and _next_case("Verifier", "reported") == 1 and _next_case("Remediator", "fixed") == 1 \
        and _next_case("human", "closed") == 1
    # …and the SAME tokens are clean on their owning status — so `human`/`—` are
    # canonical, just not owners of `accepted` (the F-0014 accept_vals they used to
    # cover, now owner-placed).
    ok = ok and _next_case("human", "reported") == 0 and _next_case("—", "closed") == 0 \
        and _next_case("Verifier", "fixed") == 0 and _next_case("Remediator", "accepted") == 0
    print(f"{'PASS' if ok else 'FAIL'}: lint validates next vocabulary + status-owner + needs-human binding (F-0014, F-0102, CF-0001 I-5)" + ("" if ok else " -> " + str([(v, _next_case(v)) for v in reject_vals] + [("⚠ needs-human@reopened", _next_case("⚠ needs-human", "reopened")), ("⚠ needs-human@accepted", _next_case("⚠ needs-human", "accepted"))])))
    failed += 0 if ok else 1

    # CF-0001 (strategy c re-census, §8 rule 5): each of the five census poisons must
    # fail closed on BOTH the surface (lint) AND the authoritative consumers — the
    # decision path (state_and_decision) and metrics. Before the fix each passed lint
    # 'clean' while a consumer read the canonical-record value past the predicate;
    # the class is closed only when no consumer reads it past the shared predicate.
    def _cf1_poison(ledger_body, files):
        with tempfile.TemporaryDirectory() as td:
            proj = Path(td)
            audit = proj / "audit"
            (audit / "findings").mkdir(parents=True)
            (audit / "XCHECK.md").write_text("x", encoding="utf-8")
            complete_audit(audit)  # a complete plan, so a MISSING gate would route to a role — not the Planner — surfacing the hole
            (audit / "LEDGER.md").write_text(_ledger(*ledger_body), encoding="utf-8")
            for name, body in files.items():
                (audit / "findings" / name).write_text(body, encoding="utf-8")
            lb = _io2.StringIO()
            with _cl2.redirect_stdout(lb):
                lint_rc = cmd_lint(proj)
            conf = {"batch_size": "8", "triage_batch_cap": "0", "session_note": ""}
            _r, _u, _c, kind, _d = state_and_decision(proj, conf)
            mb = _io2.StringIO()
            with _cl2.redirect_stdout(mb):
                m_rc = cmd_metrics(proj)
            return lint_rc, kind, m_rc
    # I-1 out-of-vocab severity: lint + decision gate + metrics all refuse.
    l1, k1, m1 = _cf1_poison(
        ["| F-0001 | a | urgent | accepted | Remediator | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: urgent\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n"})
    p1 = l1 == 1 and k1 == "stop-canonical-invalid" and m1 == 1
    # I-2 out-of-vocab status: lint + decision gate + metrics all refuse (before the
    # fix `decide` classified it by fallthrough and audited past it).
    l2, k2, m2 = _cf1_poison(
        ["| F-0001 | a | major | frobnicate | Remediator | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: frobnicate\nattempts: 0\n---\n"})
    p2 = l2 == 1 and k2 == "stop-canonical-invalid" and m2 == 1
    # I-3 two files/one id: lint AND the decision path fail closed; the REOPEN found
    # metrics still read the last-wins-collapsed survivor past the predicate, so assert
    # metrics refuses too (m3 == 1) now that it runs the SAME integrity gate.
    l3, k3, m3 = _cf1_poison(
        ["| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n",
         "F-0001-b.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: accepted\nattempts: 0\n---\n"})
    p3 = l3 == 1 and k3 == "stop-finding-duplicate-id" and m3 == 1
    # I-4 pending-triage delta (file reported / ledger accepted) with a `next` owning
    # NEITHER the pre- nor post-sync status: lint is the consumer (the decision path
    # routes by status, not next); the old blanket pending exception passed any role.
    l4, _k4, _m4 = _cf1_poison(
        ["| F-0001 | a | major | accepted | Verifier | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n"})
    p4 = l4 == 1
    # I-5 ⚠ needs-human flag on a non-reopened status: lint catches it AND decide()
    # must NOT halt the whole cycle on it (the poison's worst effect — a closed or a
    # fresh reported finding stopping everything with stop-needs-human).
    l5a, k5a, _m5a = _cf1_poison(
        ["| F-0001 | a | major | closed | ⚠ needs-human | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: closed\nattempts: 0\n---\n"})
    l5b, k5b, _m5b = _cf1_poison(
        ["| F-0001 | a | major | reported | human ⚠ needs-human | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: reported\nattempts: 0\n---\n"})
    p5 = l5a == 1 and k5a != "stop-needs-human" and l5b == 1 and k5b != "stop-needs-human"
    # I-6 (CF-0001 REOPEN, Verifier): an EMPTY canonical `status` (§2 required field)
    # with a derived ledger status. Before the fix routing AND metrics substituted the
    # ledger value and read PAST the empty canonical field (the class root); now the
    # shared predicate flags it, so lint, the decision path AND metrics all fail closed.
    l6, k6, m6 = _cf1_poison(
        ["| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: \nattempts: 0\n---\n"})
    p6 = l6 == 1 and k6 == "stop-canonical-invalid" and m6 == 1
    # I-7 (CF-0001 REOPEN, human-ruling re-take): a non-integer canonical `attempts`.
    # Before the re-take it certified as a KPI (metrics rc=0) and crashed the decision
    # path's `int(attempts)` with a raw ValueError; now the schema predicate flags it, so
    # lint, the decision path AND metrics all fail closed — cleanly (no traceback, req 5).
    l7, k7, m7 = _cf1_poison(
        ["| F-0001 | a | major | reopened | Remediator | 2026-07-21 |\n"],
        {"F-0001-a.md": "---\nid: F-0001\npass: P-01\nupdated: 2026-07-21\ntitle: a\nseverity: major\ndimension: invariants\nunit: B01\nstatus: reopened\nattempts: banana\n---\n"})
    p7 = l7 == 1 and k7 == "stop-canonical-invalid" and m7 == 1
    # I-8 (CF-0001 REOPEN): a filename/id mismatch — was lint-only, so `next`/`metrics`
    # routed off the wrong physical file. The shared structural gate now catches it.
    l8, k8, m8 = _cf1_poison(
        ["| F-0001 | a | major | accepted | Remediator | 2026-07-21 |\n"],

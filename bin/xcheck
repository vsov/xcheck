    with tempfile.TemporaryDirectory() as td:  # widen triage write surface to finding files
        mut129_wr = _mut_skills(td, "xcheck-triage/SKILL.md",
                                "Never touch finding files", "You may edit finding files")
    with tempfile.TemporaryDirectory() as td:  # rename the inherited-lock env discriminator (round-3 poison)
        mut129_inh = _mut_skills(td, "xcheck-plan/SKILL.md",
                                 "XCHECK_LOCK_INHERITED", "XCHECK_PARENT_LOCK")
    with tempfile.TemporaryDirectory() as td:  # invert the lock control ACTION only (round-4 hole): do NOT mkdir -> DO mkdir
        mut129_mkdir = _mut_skills(td, "xcheck-plan/SKILL.md",
                                   "do NOT `mkdir audit/.lock`", "DO `mkdir audit/.lock`")
    with tempfile.TemporaryDirectory() as td:  # invert the verifier control ACTION only (round-4 hole): STOP -> CONTINUE
        mut129_stop = _mut_skills(td, "xcheck-verify/SKILL.md",
                                  "STOP — you cannot prove independence", "CONTINUE — independence is assumed")
